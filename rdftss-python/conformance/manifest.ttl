    rdfs:comment "A reading is above tss:maximum: suspicious, but valid (a warning)." ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-tss/#meaning> ;
    mf:action <metadata/embedded/P5-value-above-maximum.ttl> ;
    tsst:shapes "embedded" ;
    tsst:conforms true ;
    tsst:warning "P5" .

<#embedded-P6-point-with-a-type> a tsst:MetadataTest ;
    mf:name "embedded-P6-point-with-a-type" ;
    rdfs:comment "A point states an rdf:type, which is not a property the point is read with (a warning)." ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-tss/#rdf-points> ;
    mf:action <metadata/embedded/P6-point-with-a-type.ttl> ;
    tsst:shapes "embedded" ;
    tsst:conforms true ;
    tsst:warning "P6" .

<#embedded-P7-two-readings-for-one-point> a tsst:MetadataTest ;
    mf:name "embedded-P7-two-readings-for-one-point" ;
    rdfs:comment "A point has two readings." ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-tss/#rdf-points> ;
    mf:action <metadata/embedded/P7-two-readings-for-one-point.ttl> ;
    tsst:shapes "embedded" ;
    tsst:conforms false ;
    tsst:violation "P7" .

<#embedded-P8-point-without-its-field> a tsst:MetadataTest ;
    mf:name "embedded-P8-point-without-its-field" ;

<#embedded-S12-time-step> a tsst:MetadataTest ; ;
    mf:name "embedded-S12-time-step" ; ;
    rdfs:comment "An embedded snippet states tss:timeStep." ; ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-timeseriessnippets/#storage> ; ;

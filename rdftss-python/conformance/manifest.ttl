# The TSS conformance test suite: every test, its input and its expected result.
# Written by make_suite.py; docs/conformance.md explains the test types and how to run them.
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix tsst: <https://w3id.org/tss/tests#> .

<> a mf:Manifest ;
    rdfs:label "TSS conformance tests" ;
    rdfs:comment "Tests of conforming metadata documents (SHACL), consumers (reading), stored summaries and expanders." ;
    rdfs:seeAlso <https://knowledgeonwebscale.github.io/rdf-timeseriessnippets/> ;
    mf:entries (
        <#embedded-valid-rdf-points>
        <#embedded-valid-json-points>
        <#embedded-valid-open-window>
        <#embedded-valid-times-with-offsets>
        <#embedded-valid-empty-text-is-no-value>
        <#embedded-valid-no-points-yet>
        <#embedded-valid-empty-json-array>
        <#embedded-S2-mutable-missing>
        <#embedded-S2-mutable-not-a-boolean>
        <#embedded-S3-two-snippet-classes>
        <#embedded-S4-time-field-missing>
        <#embedded-S4-time-field-not-a-field-of-the-snippet>
        <#embedded-S5-no-fields>
        <#embedded-S6-value-outside-a-point>
        <#embedded-S6-json-points-not-rdf-json>
        <#embedded-S6-json-points-not-an-array>
        <#embedded-S6-json-points-missing>
        <#embedded-S7-label-not-a-literal>
        <#embedded-S8-produced-by-a-literal>
        <#embedded-S9-key-not-the-time-field>
        <#embedded-S9-two-keys>
        <#embedded-S10-from-a-date>
        <#embedded-S11-until-before-from>
        <#embedded-S12-data-file>
        <#embedded-S12-delimiter>
        <#embedded-S12-encoding>
        <#embedded-S12-header>
        <#embedded-S12-time-base>
        <#embedded-S12-time-step>
        <#embedded-S12-step-field>
        <#embedded-S12-points-on-an-rdf-snippet>
        <#embedded-S12-has-point-on-a-json-snippet>
        <#embedded-S17-committed-until-missing>
        <#embedded-S17-committed-until-a-date-time>
        <#embedded-S20-time-field-datatype>
        <#embedded-S23-from-without-timezone>
        <#embedded-S23-point-time-without-timezone>
        <#embedded-S23-summary-time-without-timezone>
        <#embedded-S25-json-field-without-column-name>
        <#embedded-F1-field-not-typed>
        <#embedded-F1-field-of-two-snippets>
        <#embedded-F2-empty-column-name>
        <#embedded-F2-duplicate-column-names>
        <#embedded-F3-datatype-missing>
        <#embedded-F3-datatype-a-literal>
        <#embedded-F4-negative-column-index>
        <#embedded-F4-duplicate-column-indexes>
        <#embedded-F5-label-not-a-literal>
        <#embedded-F6-comment-not-a-literal>
        <#embedded-F7-minimum-not-a-number>
        <#embedded-F8-maximum-below-minimum>
        <#embedded-F9-field-without-values>
        <#embedded-F10-summary-a-literal>
        <#embedded-D3-value-encoding-on-an-embedded-field>
        <#embedded-D3-baseline-on-an-embedded-field>
        <#embedded-P1-point-without-time>
        <#embedded-P2-point-before-from>
        <#embedded-P2-point-at-until>
        <#embedded-P3-two-points-at-the-same-moment>
        <#embedded-P4-value-not-in-lexical-form>
        <#embedded-P4-value-with-another-datatype>
        <#embedded-P5-value-above-maximum>
        <#embedded-P6-point-with-a-type>
        <#embedded-P7-two-values-for-one-field>
        <#embedded-Q1-summary-with-from>
        <#embedded-Q2-summary-with-until>
        <#embedded-Q3-policy-a-literal>
        <#embedded-Q4-count-a-decimal>
        <#embedded-Q4-count-negative>
        <#embedded-Q5-missing-negative>
        <#embedded-Q6-first-time-a-date>
        <#embedded-Q7-last-time-a-date>
        <#embedded-Q8-observed-minimum-a-string>
        <#embedded-Q9-observed-maximum-a-string>
        <#embedded-Q10-mean-a-string>
        <#embedded-Q11-median-a-string>
        <#embedded-Q12-generated-at-time-a-date>
        <#external-valid-csv>
        <#external-valid-csv-no-header>
        <#external-valid-parquet>
        <#external-valid-arrow>
        <#external-valid-time-grid>
        <#external-valid-delta-from-baseline>
        <#external-valid-open-window>
        <#external-S3-mutable-missing>
        <#external-S4-time-field-missing>
        <#external-S4-time-field-not-a-field-of-the-snippet>
        <#external-S5-key-not-the-time-field>
        <#external-S6-no-fields>
        <#external-S7-two-snippet-classes>
        <#external-S8-data-file-missing>
        <#external-S8-data-file-a-literal>
        <#external-S10-delimiter-two-characters>
        <#external-S11-encoding-empty>
        <#external-S12-label-not-a-literal>
        <#external-S13-produced-by-a-literal>
        <#external-S14-until-before-from>
        <#external-S15-delimiter-on-parquet>
        <#external-S15-encoding-on-arrow>
        <#external-S17-committed-until-missing>
        <#external-S19-time-base-without-time-step>
        <#external-S18-time-base-a-date>
        <#external-S18-time-step-without-time-base>
        <#external-S19-time-step-zero>
        <#external-S19-time-step-negative>
        <#external-S20-time-field-datatype>
        <#external-S21-grid-without-step-field>
        <#external-S21-step-field-not-an-integer>
        <#external-S21-step-field-without-a-grid>
        <#external-S22-has-point>
        <#external-S22-points>
        <#external-S23-committed-until-without-timezone>
        <#external-S23-time-base-without-timezone>
        <#external-F1-field-not-typed>
        <#external-F2-column-name-missing>
        <#external-F2-duplicate-column-names>
        <#external-F2-grid-time-field-with-a-column-name>
        <#external-F3-datatype-missing>
        <#external-F4-duplicate-column-indexes>
        <#external-F8-maximum-below-minimum>
        <#external-D1-unknown-value-encoding>
        <#external-D1-delta-without-baseline>
        <#external-D2-baseline-with-another-datatype>
        <#external-D3-baseline-without-value-encoding>
        <#external-D3-value-encoding-on-the-time-field>
        <#external-Q2-summary-with-until>
        <#external-F5-label-not-a-literal>
        <#external-F6-comment-not-a-literal>
        <#external-F7-minimum-not-a-number>
        <#external-F10-summary-a-literal>
        <#external-Q1-summary-with-from>
        <#external-Q3-policy-a-literal>
        <#external-Q4-count-a-decimal>
        <#external-Q4-count-negative>
        <#external-Q5-missing-negative>
        <#external-Q6-first-time-a-date>
        <#external-Q7-last-time-a-date>
        <#external-Q8-observed-minimum-a-string>
        <#external-Q9-observed-maximum-a-string>
        <#external-Q10-mean-a-string>
        <#external-Q11-median-a-string>
        <#external-Q12-generated-at-time-a-date>
        <#external-S2-from-a-date>
        <#mixed-S1-no-snippet>
        <#mixed-S24-embedded-and-external-snippets>
        <#reading-rdf-points>
        <#reading-json-empty-values>
        <#reading-csv-delimiter>
        <#reading-csv-no-header>
        <#reading-csv-time-window>
        <#reading-csv-time-offsets>
        <#reading-time-grid>
        <#reading-time-grid-calendar-months>
        <#reading-delta-from-baseline>
        <#reading-texts-kept>
        <#reading-parquet>
        <#reading-arrow>
        <#reading-error-csv-point-without-time>
        <#reading-error-csv-value-not-in-lexical-form>
        <#reading-error-json-point-without-time>
        <#reading-error-json-value-not-in-lexical-form>
        <#summaries-up-to-date>
        <#summaries-out-of-date>
        <#summaries-out-of-date-first-time>
        <#summaries-empty-values>
        <#summaries-same-moment>
        <#summaries-decoded-values>
        <#summaries-window>
        <#expansion-rdf-points>
        <#expansion-measured-fields-only>
        <#expansion-time-grid-and-delta>
    ) .

<#embedded-valid-rdf-points> a tsst:MetadataTest ; ;
    mf:name "embedded-valid-rdf-points" ; ;
    rdfs:comment "The specification's embedded example: RDF points and a stored summary." ; ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-timeseriessnippets/#embedded-example> ; ;
    mf:action <metadata/embedded/valid-rdf-points.ttl> ;
    tsst:shapes "embedded" ;
    tsst:conforms true .

<#embedded-valid-json-points> a tsst:MetadataTest ; ;
    mf:name "embedded-valid-json-points" ; ;
    rdfs:comment "The same readings as JSON points." ; ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-timeseriessnippets/#json-points> ; ;
    mf:action <metadata/embedded/valid-json-points.ttl> ;
    tsst:shapes "embedded" ;
    tsst:conforms true .

<#embedded-valid-open-window> a tsst:MetadataTest ; ;
    mf:name "embedded-valid-open-window" ; ;
    rdfs:comment "A snippet without tss:from and tss:until: the window is open on both sides." ; ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-timeseriessnippets/#window> ; ;
    mf:action <metadata/embedded/valid-open-window.ttl> ;
    tsst:shapes "embedded" ;
    tsst:conforms true .

<#embedded-valid-times-with-offsets> a tsst:MetadataTest ; ;
    mf:name "embedded-valid-times-with-offsets" ; ;
    rdfs:comment "A point's time with an offset instead of Z." ; ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-timeseriessnippets/#times> ; ;
    mf:action <metadata/embedded/valid-times-with-offsets.ttl> ;
    tsst:shapes "embedded" ;
    tsst:conforms true .

<#embedded-valid-empty-text-is-no-value> a tsst:MetadataTest ; ;
    mf:name "embedded-valid-empty-text-is-no-value" ; ;
    rdfs:comment "An empty text (\"\") is no value, so it is not checked against xsd:double." ; ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-timeseriessnippets/#points> ; ;
    mf:action <metadata/embedded/valid-empty-text-is-no-value.ttl> ;
    tsst:shapes "embedded" ;
    tsst:conforms true .

<#embedded-valid-no-points-yet> a tsst:MetadataTest ; ;
    mf:name "embedded-valid-no-points-yet" ; ;
    rdfs:comment "A snippet may have no points yet." ; ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-timeseriessnippets/#rdf-points> ; ;
    mf:action <metadata/embedded/valid-no-points-yet.ttl> ;
    tsst:shapes "embedded" ;
    tsst:conforms true .

<#embedded-valid-empty-json-array> a tsst:MetadataTest ; ;
    mf:name "embedded-valid-empty-json-array" ; ;
    rdfs:comment "\"[]\" holds no points." ; ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-timeseriessnippets/#json-points> ; ;
    mf:action <metadata/embedded/valid-empty-json-array.ttl> ;
    tsst:shapes "embedded" ;
    tsst:conforms true .

<#embedded-S2-mutable-missing> a tsst:MetadataTest ; ;
    mf:name "embedded-S2-mutable-missing" ; ;
    rdfs:comment "The snippet has no tss:mutable." ; ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-timeseriessnippets/#change> ; ;
    mf:action <metadata/embedded/S2-mutable-missing.ttl> ;
    tsst:shapes "embedded" ;
    tsst:conforms false ;
    tsst:violation "S2" .

<#embedded-S2-mutable-not-a-boolean> a tsst:MetadataTest ; ;
    mf:name "embedded-S2-mutable-not-a-boolean" ; ;
    rdfs:comment "tss:mutable is the string \"yes\", not an xsd:boolean." ; ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-timeseriessnippets/#change> ; ;
    mf:action <metadata/embedded/S2-mutable-not-a-boolean.ttl> ;
    tsst:shapes "embedded" ;
    tsst:conforms false ;
    tsst:violation "S2" .

<#embedded-S3-two-snippet-classes> a tsst:MetadataTest ; ;
    mf:name "embedded-S3-two-snippet-classes" ; ;
    rdfs:comment "The snippet states two snippet classes." ; ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-timeseriessnippets/#storage> ; ;
    mf:action <metadata/embedded/S3-two-snippet-classes.ttl> ;
    tsst:shapes "embedded" ;
    tsst:conforms false ;
    tsst:violation "S3" .

<#embedded-S4-time-field-missing> a tsst:MetadataTest ; ;
    mf:name "embedded-S4-time-field-missing" ; ;
    rdfs:comment "The snippet has no tss:timeField." ; ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-timeseriessnippets/#time-and-key> ; ;
    mf:action <metadata/embedded/S4-time-field-missing.ttl> ;
    tsst:shapes "embedded" ;
    tsst:conforms false ;
    tsst:violation "S4" .

<#embedded-S4-time-field-not-a-field-of-the-snippet> a tsst:MetadataTest ; ;
    mf:name "embedded-S4-time-field-not-a-field-of-the-snippet" ; ;
    rdfs:comment "The time field is not one of the snippet's fields." ; ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-timeseriessnippets/#time-and-key> ; ;
    mf:action <metadata/embedded/S4-time-field-not-a-field-of-the-snippet.ttl> ;
    tsst:shapes "embedded" ;
    tsst:conforms false ;
    tsst:violation "S4" .

<#embedded-S5-no-fields> a tsst:MetadataTest ; ;
    mf:name "embedded-S5-no-fields" ; ;
    rdfs:comment "The snippet has no tss:hasField." ; ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-timeseriessnippets/#fields> ; ;
    mf:action <metadata/embedded/S5-no-fields.ttl> ;
    tsst:shapes "embedded" ;
    tsst:conforms false ;
    tsst:violation "S5" .

<#embedded-S6-value-outside-a-point> a tsst:MetadataTest ; ;
    mf:name "embedded-S6-value-outside-a-point" ; ;
    rdfs:comment "A value of a field is on a node that the snippet does not link to with tss:hasPoint." ; ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-timeseriessnippets/#rdf-points> ; ;
    mf:action <metadata/embedded/S6-value-outside-a-point.ttl> ;
    tsst:shapes "embedded" ;
    tsst:conforms false ;
    tsst:violation "S6" .

<#embedded-S6-json-points-not-rdf-json> a tsst:MetadataTest ; ;
    mf:name "embedded-S6-json-points-not-rdf-json" ; ;
    rdfs:comment "tss:points is a plain string, not an rdf:JSON literal." ; ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-timeseriessnippets/#json-points> ; ;
    mf:action <metadata/embedded/S6-json-points-not-rdf-json.ttl> ;
    tsst:shapes "embedded" ;
    tsst:conforms false ;
    tsst:violation "S6" .

<#embedded-S6-json-points-not-an-array> a tsst:MetadataTest ; ;
    mf:name "embedded-S6-json-points-not-an-array" ; ;
    rdfs:comment "tss:points holds a JSON object, not an array." ; ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-timeseriessnippets/#json-points> ; ;
    mf:action <metadata/embedded/S6-json-points-not-an-array.ttl> ;
    tsst:shapes "embedded" ;
    tsst:conforms false ;
    tsst:violation "S6" .

<#embedded-S6-json-points-missing> a tsst:MetadataTest ; ;
    mf:name "embedded-S6-json-points-missing" ; ;
    rdfs:comment "A tss:EmbeddedJSONSnippet without tss:points." ; ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-timeseriessnippets/#json-points> ; ;
    mf:action <metadata/embedded/S6-json-points-missing.ttl> ;
    tsst:shapes "embedded" ;
    tsst:conforms false ;
    tsst:violation "S6" .

<#embedded-S7-label-not-a-literal> a tsst:MetadataTest ; ;
    mf:name "embedded-S7-label-not-a-literal" ; ;
    rdfs:comment "The snippet's label is an IRI." ; ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-timeseriessnippets/#provenance> ; ;
    mf:action <metadata/embedded/S7-label-not-a-literal.ttl> ;
    tsst:shapes "embedded" ;
    tsst:conforms false ;
    tsst:violation "S7" .

<#embedded-S8-produced-by-a-literal> a tsst:MetadataTest ; ;
    mf:name "embedded-S8-produced-by-a-literal" ; ;
    rdfs:comment "tss:producedBy is a literal, not an IRI." ; ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-timeseriessnippets/#provenance> ; ;
    mf:action <metadata/embedded/S8-produced-by-a-literal.ttl> ;
    tsst:shapes "embedded" ;
    tsst:conforms false ;
    tsst:violation "S8" .

<#embedded-S9-key-not-the-time-field> a tsst:MetadataTest ; ;
    mf:name "embedded-S9-key-not-the-time-field" ; ;
    rdfs:comment "The key is not the time field." ; ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-timeseriessnippets/#time-and-key> ; ;
    mf:action <metadata/embedded/S9-key-not-the-time-field.ttl> ;
    tsst:shapes "embedded" ;
    tsst:conforms false ;
    tsst:violation "S9" .

<#embedded-S9-two-keys> a tsst:MetadataTest ; ;
    mf:name "embedded-S9-two-keys" ; ;
    rdfs:comment "The snippet states two keys." ; ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-timeseriessnippets/#time-and-key> ; ;
    mf:action <metadata/embedded/S9-two-keys.ttl> ;
    tsst:shapes "embedded" ;
    tsst:conforms false ;
    tsst:violation "S9" .

<#embedded-S10-from-a-date> a tsst:MetadataTest ; ;
    mf:name "embedded-S10-from-a-date" ; ;
    rdfs:comment "tss:from is an xsd:date, not an xsd:dateTimeStamp." ; ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-timeseriessnippets/#window> ; ;
    mf:action <metadata/embedded/S10-from-a-date.ttl> ;
    tsst:shapes "embedded" ;
    tsst:conforms false ;
    tsst:violation "S10" .

<#embedded-S11-until-before-from> a tsst:MetadataTest ; ;
    mf:name "embedded-S11-until-before-from" ; ;
    rdfs:comment "tss:until is before tss:from." ; ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-timeseriessnippets/#window> ; ;
    mf:action <metadata/embedded/S11-until-before-from.ttl> ;
    tsst:shapes "embedded" ;
    tsst:conforms false ;
    tsst:violation "S11" .

<#embedded-S12-data-file> a tsst:MetadataTest ; ;
    mf:name "embedded-S12-data-file" ; ;
    rdfs:comment "An embedded snippet states tss:dataFile." ; ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-timeseriessnippets/#storage> ; ;
    mf:action <metadata/embedded/S12-data-file.ttl> ;
    tsst:shapes "embedded" ;
    tsst:conforms false ;
    tsst:violation "S12" .

<#embedded-S12-delimiter> a tsst:MetadataTest ; ;
    mf:name "embedded-S12-delimiter" ; ;
    rdfs:comment "An embedded snippet states tss:delimiter." ; ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-timeseriessnippets/#storage> ; ;
    mf:action <metadata/embedded/S12-delimiter.ttl> ;
    tsst:shapes "embedded" ;
    tsst:conforms false ;
    tsst:violation "S12" .


<#embedded-S17-committed-until-missing> a tsst:MetadataTest ; ;
    mf:name "embedded-S17-committed-until-missing" ; ;
    rdfs:comment "The snippet has no tss:committedUntil." ; ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-timeseriessnippets/#change> ; ;

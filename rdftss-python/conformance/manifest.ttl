<#reading-rdf-points> a tsst:ReadTest ; ;
    mf:name "reading-rdf-points" ; ;
    rdfs:comment "RDF points: one node per point, the field IRIs as predicates." ; ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-timeseriessnippets/#rdf-points> ; ;
    mf:action <reading/rdf-points/metadata.ttl> ;
    mf:result <reading/rdf-points/expected.csv> .

<#reading-json-empty-values> a tsst:ReadTest ; ;
    mf:name "reading-json-empty-values" ; ;
    rdfs:comment "JSON points: \"\", null and a missing key are empty values." ; ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-timeseriessnippets/#json-points> ; ;
    mf:action <reading/json-empty-values/metadata.ttl> ;
    mf:result <reading/json-empty-values/expected.csv> .

<#reading-csv-delimiter> a tsst:ReadTest ; ;
    mf:name "reading-csv-delimiter" ; ;
    rdfs:comment "A CSV file with ';' as delimiter and a header line." ; ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-timeseriessnippets/#csv> ; ;
    mf:action <reading/csv-delimiter/metadata.ttl> ;
    mf:result <reading/csv-delimiter/expected.csv> .

<#reading-csv-no-header> a tsst:ReadTest ; ;
    mf:name "reading-csv-no-header" ; ;
    rdfs:comment "A CSV file without a header line: columns by tss:columnIndex." ; ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-timeseriessnippets/#csv> ; ;
    mf:action <reading/csv-no-header/metadata.ttl> ;
    mf:result <reading/csv-no-header/expected.csv> .

<#reading-csv-time-window> a tsst:ReadTest ; ;
    mf:name "reading-csv-time-window" ; ;
    rdfs:comment "Only the rows in [tss:from, tss:until) are points; times compare as moments." ; ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-timeseriessnippets/#window> ; ;
    mf:action <reading/csv-time-window/metadata.ttl> ;
    mf:result <reading/csv-time-window/expected.csv> .

<#reading-csv-time-offsets> a tsst:ReadTest ; ;
    mf:name "reading-csv-time-offsets" ; ;
    rdfs:comment "Times with offsets are the same moments as in Z." ; ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-timeseriessnippets/#times> ; ;
    mf:action <reading/csv-time-offsets/metadata.ttl> ;
    mf:result <reading/csv-time-offsets/expected.csv> .

<#reading-time-grid> a tsst:ReadTest ; ;
    mf:name "reading-time-grid" ; ;
    rdfs:comment "On a time grid, the time of a row is tss:timeBase + step × tss:timeStep." ; ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-timeseriessnippets/#time-grid> ; ;
    mf:action <reading/time-grid/metadata.ttl> ;
    mf:result <reading/time-grid/expected.csv> .

<#reading-time-grid-calendar-months> a tsst:ReadTest ; ;
    mf:name "reading-time-grid-calendar-months" ; ;
    rdfs:comment "A step of P1M from 31 January: n months are added at once, and the day is clamped to the month." ; ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-timeseriessnippets/#time-grid> ; ;
    mf:action <reading/time-grid-calendar-months/metadata.ttl> ;
    mf:result <reading/time-grid-calendar-months/expected.csv> .

<#reading-delta-from-baseline> a tsst:ReadTest ; ;
    mf:name "reading-delta-from-baseline" ; ;
    rdfs:comment "The specification's delta example: 4750 + 60.5 and 4750 + (-27.6)." ; ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-timeseriessnippets/#value-encoding> ; ;
    mf:action <reading/delta-from-baseline/metadata.ttl> ;
    mf:result <reading/delta-from-baseline/expected.csv> .

<#reading-texts-kept> a tsst:ReadTest ; ;
    mf:name "reading-texts-kept" ; ;
    rdfs:comment "A text keeps its spaces, and a text of only spaces is a value, not an empty value." ; ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-timeseriessnippets/#datatypes> ; ;
    mf:action <reading/texts-kept/metadata.ttl> ;
    mf:result <reading/texts-kept/expected.csv> .

<#reading-parquet> a tsst:ReadTest ; ;
    mf:name "reading-parquet" ; ;
    rdfs:comment "A Parquet file: a UTC timestamp column and a DOUBLE column." ; ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-timeseriessnippets/#parquet> ; ;
    mf:action <reading/parquet/metadata.ttl> ;
    mf:result <reading/parquet/expected.csv> .

<#reading-arrow> a tsst:ReadTest ; ;
    mf:name "reading-arrow" ; ;
    rdfs:comment "An Arrow IPC file: nanosecond UTC timestamps and a DOUBLE column." ; ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-timeseriessnippets/#arrow> ; ;
    mf:action <reading/arrow/metadata.ttl> ;
    mf:result <reading/arrow/expected.csv> .

<#reading-error-csv-point-without-time> a tsst:ReadTest ; ;
    mf:name "reading-error-csv-point-without-time" ; ;
    rdfs:comment "A row without a time is an error." ; ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-timeseriessnippets/#expanding> ; ;
    mf:action <reading/error-csv-point-without-time/metadata.ttl> ;
    mf:result tsst:Error .

<#reading-error-csv-value-not-in-lexical-form> a tsst:ReadTest ; ;
    mf:name "reading-error-csv-value-not-in-lexical-form" ; ;
    rdfs:comment "A value that is not in the lexical form of its datatype (a decimal comma) is an error." ; ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-timeseriessnippets/#expanding> ; ;
    mf:action <reading/error-csv-value-not-in-lexical-form/metadata.ttl> ;
    mf:result tsst:Error .

<#reading-error-json-point-without-time> a tsst:ReadTest ; ;
    mf:name "reading-error-json-point-without-time" ; ;
    rdfs:comment "A JSON point without a time is an error." ; ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-timeseriessnippets/#expanding> ; ;
    mf:action <reading/error-json-point-without-time/metadata.ttl> ;
    mf:result tsst:Error .

<#reading-error-json-value-not-in-lexical-form> a tsst:ReadTest ; ;
    mf:name "reading-error-json-value-not-in-lexical-form" ; ;
    rdfs:comment "A JSON value \"high\" is not in the lexical form of xsd:double: an error." ; ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-timeseriessnippets/#expanding> ; ;
    mf:action <reading/error-json-value-not-in-lexical-form/metadata.ttl> ;
    mf:result tsst:Error .

<#summaries-up-to-date> a tsst:SummaryTest ; ;
    mf:name "summaries-up-to-date" ; ;
    rdfs:comment "The summary of the embedded example matches its three points." ; ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-timeseriessnippets/#summaries> ; ;
    mf:action <summaries/up-to-date/metadata.ttl> ;
    tsst:upToDate true .

<#summaries-out-of-date> a tsst:SummaryTest ; ;
    mf:name "summaries-out-of-date" ; ;
    rdfs:comment "A point was added, but tss:count and tss:mean were not recomputed." ; ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-timeseriessnippets/#summaries> ; ;
    mf:action <summaries/out-of-date/metadata.ttl> ;
    tsst:upToDate false ;
    tsst:outOfDate "tss:count" ;
    tsst:outOfDate "tss:mean" .

<#summaries-out-of-date-first-time> a tsst:SummaryTest ; ;
    mf:name "summaries-out-of-date-first-time" ; ;
    rdfs:comment "tss:firstTime is not the time of the first point with a value." ; ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-timeseriessnippets/#summaries> ; ;
    mf:action <summaries/out-of-date-first-time/metadata.ttl> ;
    tsst:upToDate false ;
    tsst:outOfDate "tss:firstTime" .

<#summaries-empty-values> a tsst:SummaryTest ; ;
    mf:name "summaries-empty-values" ; ;
    rdfs:comment "tss:ExcludeEmptyValues: an empty value is counted in tss:missing and left out of the numbers." ; ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-timeseriessnippets/#summaries> ; ;
    mf:action <summaries/empty-values/metadata.ttl> ;
    tsst:upToDate true .

<#summaries-same-moment> a tsst:SummaryTest ; ;
    mf:name "summaries-same-moment" ; ;
    rdfs:comment "tss:lastTime written with an offset is the same moment as the last point's time." ; ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-timeseriessnippets/#times> ; ;
    mf:action <summaries/same-moment/metadata.ttl> ;
    tsst:upToDate true .

<#summaries-decoded-values> a tsst:SummaryTest ; ;
    mf:name "summaries-decoded-values" ; ;
    rdfs:comment "The numbers of a summary are computed from the decoded values." ; ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-timeseriessnippets/#value-encoding> ; ;
    mf:action <summaries/decoded-values/metadata.ttl> ;
    tsst:upToDate true .

<#summaries-window> a tsst:SummaryTest ; ;
    mf:name "summaries-window" ; ;
    rdfs:comment "Only the points in the window count: rows outside it are left out." ; ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-timeseriessnippets/#summaries> ; ;
    mf:action <summaries/window/metadata.ttl> ;
    tsst:upToDate true .

<#expansion-rdf-points> a tsst:ExpansionTest ; ;
    mf:name "expansion-rdf-points" ; ;
    rdfs:comment "The embedded example: one observation per value, with what its field says." ; ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-timeseriessnippets/#expanding> ; ;
    mf:action <expansion/rdf-points/metadata.ttl> ;
    mf:result <expansion/rdf-points/expected.csv> .

<#expansion-measured-fields-only> a tsst:ExpansionTest ; ;
    mf:name "expansion-measured-fields-only" ; ;
    rdfs:comment "An empty value gives no observation, and neither does a field without tss:observedProperty." ; ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-timeseriessnippets/#expanding> ; ;
    mf:action <expansion/measured-fields-only/metadata.ttl> ;
    mf:result <expansion/measured-fields-only/expected.csv> .

<#expansion-time-grid-and-delta> a tsst:ExpansionTest ; ;
    mf:name "expansion-time-grid-and-delta" ; ;
    rdfs:comment "On a time grid with a value encoding: the time of each step, and the decoded value." ; ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-timeseriessnippets/#value-encoding> ; ;
    mf:action <expansion/time-grid-and-delta/metadata.ttl> ;
    mf:result <expansion/time-grid-and-delta/expected.csv> .

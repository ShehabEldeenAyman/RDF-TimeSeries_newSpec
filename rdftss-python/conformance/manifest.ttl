    mf:action <reading/csv-delimiter/metadata.ttl> ;
    mf:result <reading/csv-delimiter/expected.csv> .

<#reading-csv-no-header> a tsst:ReadTest ;
    mf:name "reading-csv-no-header" ;
    rdfs:comment "A CSV file without a header line: columns by tss:columnIndex." ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-tss/#csv> ;
    mf:action <reading/csv-no-header/metadata.ttl> ;
    mf:result <reading/csv-no-header/expected.csv> .

<#reading-csv-describing-field> a tsst:ReadTest ;
    mf:name "reading-csv-describing-field" ;
    rdfs:comment "A describing field of a CSV source is read from its column." ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-tss/#describing> ;
    mf:action <reading/csv-describing-field/metadata.ttl> ;
    mf:result <reading/csv-describing-field/expected.csv> .

<#reading-csv-time-window> a tsst:ReadTest ;
    mf:name "reading-csv-time-window" ;
    rdfs:comment "Only the rows in [tss:from, tss:until) are read; times compare as moments." ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-tss/#window> ;
    mf:action <reading/csv-time-window/metadata.ttl> ;
    mf:result <reading/csv-time-window/expected.csv> .

<#reading-csv-time-offsets> a tsst:ReadTest ;
    mf:name "reading-csv-time-offsets" ;
    rdfs:comment "Times with offsets are the same moments as in Z." ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-tss/#times> ;
    mf:action <reading/csv-time-offsets/metadata.ttl> ;
    mf:result <reading/csv-time-offsets/expected.csv> .

<#reading-time-grid> a tsst:ReadTest ;
    mf:name "reading-time-grid" ;
    rdfs:comment "On a time grid, the time of a row is tss:timeBase + step × tss:timeStep." ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-tss/#time-grid> ;
    mf:action <reading/time-grid/metadata.ttl> ;
    mf:result <reading/time-grid/expected.csv> .

<#reading-time-grid-by-position> a tsst:ReadTest ;
    mf:name "reading-time-grid-by-position" ;
    rdfs:comment "A time grid without a step field: the step of a row is its position, and an empty line is a step without readings." ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-tss/#time-grid> ;
    mf:action <reading/time-grid-by-position/metadata.ttl> ;
    mf:result <reading/time-grid-by-position/expected.csv> .

<#reading-time-grid-calendar-months> a tsst:ReadTest ;
    mf:name "reading-time-grid-calendar-months" ;
    rdfs:comment "A step of P1M from 31 January: n months are added at once, and the day is clamped to the month." ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-tss/#time-grid> ;
    mf:action <reading/time-grid-calendar-months/metadata.ttl> ;
    mf:result <reading/time-grid-calendar-months/expected.csv> .

<#reading-delta-from-baseline> a tsst:ReadTest ;
    mf:name "reading-delta-from-baseline" ;
    rdfs:comment "The specification's delta example: 4750 + 60.5 and 4750 + (-27.6)." ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-tss/#value-encoding> ;
    mf:action <reading/delta-from-baseline/metadata.ttl> ;
    mf:result <reading/delta-from-baseline/expected.csv> .

<#reading-texts-kept> a tsst:ReadTest ;
    mf:name "reading-texts-kept" ;
    rdfs:comment "A text keeps its spaces, and a text of only spaces is a value, not an empty value." ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-tss/#datatypes> ;
    mf:action <reading/texts-kept/metadata.ttl> ;
    mf:result <reading/texts-kept/expected.csv> .

<#reading-parquet> a tsst:ReadTest ;
    mf:name "reading-parquet" ;
    rdfs:comment "A Parquet file: a UTC timestamp column and a DOUBLE column." ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-tss/#parquet> ;
    mf:action <reading/parquet/metadata.ttl> ;
    mf:result <reading/parquet/expected.csv> .

<#reading-arrow> a tsst:ReadTest ;
    mf:name "reading-arrow" ;
    rdfs:comment "An Arrow IPC file: nanosecond UTC timestamps and a DOUBLE column." ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-tss/#arrow> ;
    mf:action <reading/arrow/metadata.ttl> ;
    mf:result <reading/arrow/expected.csv> .

<#reading-rdf-message-log> a tsst:ReadTest ;
    mf:name "reading-rdf-message-log" ;
    rdfs:comment "A growing source's RDF Message Log is read as the merge of its messages." ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-tss/#rdf-points> ;
    mf:action <reading/rdf-message-log/metadata.ttl> ;
    mf:result <reading/rdf-message-log/expected.csv> .

<#reading-rdf-message-log-unfinished-message> a tsst:ReadTest ;
    mf:name "reading-rdf-message-log-unfinished-message" ;
    rdfs:comment "Text after the last message delimiter is a message still being written: it is not read." ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-tss/#range-requests> ;
    mf:action <reading/rdf-message-log-unfinished-message/metadata.ttl> ;
    mf:result <reading/rdf-message-log-unfinished-message/expected.csv> .

<#reading-rdf-message-log-blank-node-labels> a tsst:ReadTest ;
    mf:name "reading-rdf-message-log-blank-node-labels" ;
    rdfs:comment "Blank node labels are scoped to their message: _:p in two messages are two points." ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-tss/#rdf-points> ;
    mf:action <reading/rdf-message-log-blank-node-labels/metadata.ttl> ;
    mf:result <reading/rdf-message-log-blank-node-labels/expected.csv> .

<#reading-csv-growing-unfinished-record> a tsst:ReadTest ;
    mf:name "reading-csv-growing-unfinished-record" ;
    rdfs:comment "In a growing CSV source, a last record without its line break is still being written: it is not read." ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-tss/#appending-data-files> ;
    mf:action <reading/csv-growing-unfinished-record/metadata.ttl> ;
    mf:result <reading/csv-growing-unfinished-record/expected.csv> .

<#reading-csv-immutable-last-record-without-line-break> a tsst:ReadTest ;
    mf:name "reading-csv-immutable-last-record-without-line-break" ;
    rdfs:comment "In an immutable CSV source, a last record without a line break is read." ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-tss/#csv> ;
    mf:action <reading/csv-immutable-last-record-without-line-break/metadata.ttl> ;
    mf:result <reading/csv-immutable-last-record-without-line-break/expected.csv> .

<#reading-arrow-stream> a tsst:ReadTest ;
    mf:name "reading-arrow-stream" ;
    rdfs:comment "A growing Arrow source: its data file is an Arrow IPC stream, told apart by its first bytes." ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-tss/#arrow> ;
    mf:action <reading/arrow-stream/metadata.ttl> ;
    mf:result <reading/arrow-stream/expected.csv> .

<#reading-error-csv-row-without-time> a tsst:ReadTest ;
    mf:name "reading-error-csv-row-without-time" ;
    rdfs:comment "A row without a time is an error." ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-tss/#expanding> ;
    mf:action <reading/error-csv-row-without-time/metadata.ttl> ;
    mf:result tsst:Error .

<#reading-error-csv-value-not-in-lexical-form> a tsst:ReadTest ;
    mf:name "reading-error-csv-value-not-in-lexical-form" ;
    rdfs:comment "A value that is not in the lexical form of its datatype (a decimal comma) is an error." ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-tss/#expanding> ;
    mf:action <reading/error-csv-value-not-in-lexical-form/metadata.ttl> ;
    mf:result tsst:Error .

<#reading-error-json-row-without-time> a tsst:ReadTest ;
    mf:name "reading-error-json-row-without-time" ;
    rdfs:comment "A JSON row without a time is an error." ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-tss/#expanding> ;
    mf:action <reading/error-json-row-without-time/metadata.ttl> ;
    mf:result tsst:Error .

<#reading-error-json-value-not-in-lexical-form> a tsst:ReadTest ;
    mf:name "reading-error-json-value-not-in-lexical-form" ;
    rdfs:comment "A JSON value \"high\" is not in the lexical form of xsd:double: an error." ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-tss/#expanding> ;
    mf:action <reading/error-json-value-not-in-lexical-form/metadata.ttl> ;
    mf:result tsst:Error .

<#reading-error-rdf-two-points-of-one-field-at-one-time> a tsst:ReadTest ;
    mf:name "reading-error-rdf-two-points-of-one-field-at-one-time" ;
    rdfs:comment "Two points of the value field at the same moment (08:15Z and 10:15+02:00): an error." ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-tss/#time-and-key> ;
    mf:action <reading/error-rdf-two-points-of-one-field-at-one-time/metadata.ttl> ;
    mf:result tsst:Error .

<#reading-error-rdf-point-without-its-field> a tsst:ReadTest ;
    mf:name "reading-error-rdf-point-without-its-field" ;
    rdfs:comment "A point without tss:field in a source with two value fields: its reading belongs to no field." ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-tss/#rdf-points> ;
    mf:action <reading/error-rdf-point-without-its-field/metadata.ttl> ;
    mf:result tsst:Error .

<#summaries-up-to-date> a tsst:SummaryTest ;
    mf:name "summaries-up-to-date" ;
    rdfs:comment "The summary of the embedded example matches its three rows." ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-tss/#summaries> ;
    mf:action <summaries/up-to-date/metadata.ttl> ;
    tsst:upToDate true .

<#summaries-out-of-date> a tsst:SummaryTest ;
    mf:name "summaries-out-of-date" ;
    rdfs:comment "A row was added, but tss:count and tss:mean were not recomputed." ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-tss/#summaries> ;
    mf:action <summaries/out-of-date/metadata.ttl> ;
    tsst:upToDate false ;
    tsst:outOfDate "tss:count" ;
    tsst:outOfDate "tss:mean" .

<#summaries-out-of-date-first-time> a tsst:SummaryTest ;
    mf:name "summaries-out-of-date-first-time" ;
    rdfs:comment "tss:firstTime is not the time of the first row with a value." ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-tss/#summaries> ;
    mf:action <summaries/out-of-date-first-time/metadata.ttl> ;
    tsst:upToDate false ;
    tsst:outOfDate "tss:firstTime" .

<#summaries-empty-values> a tsst:SummaryTest ;
    mf:name "summaries-empty-values" ;
    rdfs:comment "tss:ExcludeEmptyValues: an empty value is counted in tss:missing and left out of the numbers." ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-tss/#summaries> ;
    mf:action <summaries/empty-values/metadata.ttl> ;
    tsst:upToDate true .

<#summaries-same-moment> a tsst:SummaryTest ;
    mf:name "summaries-same-moment" ;
    rdfs:comment "tss:lastTime written with an offset is the same moment as the last row's time." ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-tss/#times> ;
    mf:action <summaries/same-moment/metadata.ttl> ;
    tsst:upToDate true .

<#summaries-decoded-values> a tsst:SummaryTest ;
    mf:name "summaries-decoded-values" ;
    rdfs:comment "The numbers of a summary are computed from the decoded values." ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-tss/#value-encoding> ;
    mf:action <summaries/decoded-values/metadata.ttl> ;
    tsst:upToDate true .

<#summaries-window> a tsst:SummaryTest ;
    mf:name "summaries-window" ;
    rdfs:comment "Only the rows in the window count: rows outside it are left out." ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-tss/#summaries> ;
    mf:action <summaries/window/metadata.ttl> ;
    tsst:upToDate true .

<#expansion-rdf-points> a tsst:ExpansionTest ;
    mf:name "expansion-rdf-points" ;
    rdfs:comment "The embedded example: each point with its value field, its time and its reading." ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-tss/#expanding> ;
    mf:action <expansion/rdf-points/metadata.ttl> ;
    mf:result <expansion/rdf-points/expected.csv> .

<#expansion-two-value-fields> a tsst:ExpansionTest ;
    mf:name "expansion-two-value-fields" ;
    rdfs:comment "The multi-sensor example: three rows hold five points." ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-tss/#expanding> ;
    mf:action <expansion/two-value-fields/metadata.ttl> ;
    mf:result <expansion/two-value-fields/expected.csv> .

<#expansion-empty-values-and-describing-fields> a tsst:ExpansionTest ;
    mf:name "expansion-empty-values-and-describing-fields" ;
    rdfs:comment "An empty reading gives no point, and a describing field is no point: its value is on the points it describes, with its field property." ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-tss/#expanding> ;
    mf:action <expansion/empty-values-and-describing-fields/metadata.ttl> ;
    mf:result <expansion/empty-values-and-describing-fields/expected.csv> .

<#expansion-time-grid-and-delta> a tsst:ExpansionTest ;
    mf:name "expansion-time-grid-and-delta" ;
    rdfs:comment "On a time grid with a value encoding: the time of each step, and the decoded value." ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-tss/#value-encoding> ;
    mf:action <expansion/time-grid-and-delta/metadata.ttl> ;
    mf:result <expansion/time-grid-and-delta/expected.csv> .

<#expansion-about-url> a tsst:ExpansionTest ;
    mf:name "expansion-about-url" ;
    rdfs:comment "tss:aboutUrl makes the IRI of each point from the values of its row, as a URI template." ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-tss/#point-iris> ;
    mf:action <expansion/about-url/metadata.ttl> ;
    mf:result <expansion/about-url/expected.csv> .

    mf:name "embedded-S12-encoding" ; ;
    rdfs:comment "An embedded snippet states tss:encoding." ; ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-timeseriessnippets/#storage> ; ;
    mf:action <metadata/embedded/S12-encoding.ttl> ;
    tsst:shapes "embedded" ;
    tsst:conforms false ;
    tsst:violation "S12" .

<#embedded-S12-header> a tsst:MetadataTest ; ;
    mf:name "embedded-S12-header" ; ;
    rdfs:comment "An embedded snippet states tss:header." ; ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-timeseriessnippets/#storage> ; ;
    mf:action <metadata/embedded/S12-header.ttl> ;
    tsst:shapes "embedded" ;
    tsst:conforms false ;
    tsst:violation "S12" .

<#embedded-S12-time-base> a tsst:MetadataTest ; ;
    mf:name "embedded-S12-time-base" ; ;
    rdfs:comment "An embedded snippet states tss:timeBase." ; ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-timeseriessnippets/#storage> ; ;
    mf:action <metadata/embedded/S12-time-base.ttl> ;
    tsst:shapes "embedded" ;
    tsst:conforms false ;

# The TSS conformance test suite: every test, its input and its expected result.
# Written by make_suite.py; docs/conformance.md explains the test types and how to run them.
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix tsst: <https://w3id.org/tss/tests#> .

<> a mf:Manifest ;
    rdfs:label "TSS conformance tests" ;
    rdfs:comment "Tests of conforming metadata documents (SHACL), consumers (reading), stored summaries and expanders." ;
    rdfs:seeAlso <https://knowledgeonwebscale.github.io/rdf-tss/> ;
    mf:entries (
        <#embedded-valid-rdf-points>
        <#embedded-valid-rdf-points-with-their-field>
        <#embedded-valid-two-value-fields>
        <#embedded-valid-describing-field>
        <#embedded-valid-describing-field-default-property>
        <#embedded-valid-json-rows>
        <#embedded-valid-open-window>
        <#embedded-valid-times-with-offsets>
        <#embedded-valid-date-time-stamp>
        <#embedded-valid-empty-text-is-no-value>
        <#embedded-P9-point-with-an-empty-reading>
        <#embedded-valid-no-points-yet>
        <#embedded-valid-empty-json-array>
        <#embedded-valid-growing-json-rows>
        <#embedded-valid-growing-message-log>
        <#embedded-valid-ended-message-log>
        <#embedded-valid-range-requests>
        <#embedded-S2-immutable-not-a-boolean>
        <#embedded-S2-two-immutable-values>
        <#embedded-S26-summary-of-a-growing-source>
        <#embedded-S26-summary-with-immutable-false>
        <#embedded-S28-range-requests-on-json-rows>
        <#embedded-S3-two-source-classes>
        <#embedded-S4-time-field-missing>
        <#embedded-S4-time-field-not-a-field-of-the-source>
        <#embedded-S5-no-fields>
        <#embedded-S6-point-not-linked-to-its-source>
        <#embedded-S6-json-points-not-rdf-json>
        <#embedded-S6-json-points-not-an-array>
        <#embedded-S6-json-points-missing>
        <#embedded-S7-label-not-a-literal>
        <#embedded-S8-produced-by-a-literal>
        <#embedded-S9-key-not-the-time-field>
        <#embedded-S9-two-keys>
        <#embedded-S10-from-a-date>
        <#embedded-S11-until-before-from>
        <#embedded-S12-data-file>
        <#embedded-S12-delimiter>
        <#embedded-S12-encoding>
        <#embedded-S12-header>
        <#embedded-S12-time-base>
        <#embedded-S12-time-step>
        <#embedded-S12-step-field>
        <#embedded-S12-points-on-an-rdf-source>
        <#embedded-S12-has-point-on-a-json-source>
        <#embedded-S20-time-field-datatype>
        <#embedded-S23-from-without-timezone>
        <#embedded-S23-point-time-without-timezone>
        <#embedded-S23-summary-time-without-timezone>
        <#embedded-S25-json-field-without-column-name>
        <#embedded-S29-no-value-field>
        <#embedded-F1-field-of-both-kinds>
        <#embedded-F1-field-without-a-kind>
        <#embedded-F1-field-of-two-sources>
        <#embedded-F2-empty-column-name>
        <#embedded-F2-duplicate-column-names>
        <#embedded-F3-datatype-missing>
        <#embedded-F3-datatype-a-literal>
        <#embedded-F4-negative-column-index>
        <#embedded-F4-duplicate-column-indexes>
        <#embedded-F5-label-not-a-literal>
        <#embedded-F6-comment-not-a-literal>
        <#embedded-F7-minimum-not-a-number>
        <#embedded-F8-maximum-below-minimum>
        <#embedded-F9-value-field-without-points>
        <#embedded-F10-summary-a-literal>
        <#embedded-F11-time-field-a-value-field>
        <#embedded-F12-context-field-with-an-observed-property>
        <#embedded-F13-describing-field-without-property-or-column-name>
        <#embedded-F14-about-url-on-rdf-points>
        <#embedded-F15-describing-a-context-field>
        <#embedded-D3-value-encoding-on-an-embedded-field>
        <#embedded-D3-baseline-on-an-embedded-field>
        <#embedded-P1-point-without-time>
        <#embedded-P2-point-before-from>
        <#embedded-P2-point-at-until>
        <#embedded-P3-two-points-at-the-same-moment>
        <#embedded-P4-value-not-in-lexical-form>
        <#embedded-P4-value-with-another-datatype>
        <#embedded-P5-value-above-maximum>
        <#embedded-P6-point-with-a-type>
        <#embedded-P7-two-readings-for-one-point>
        <#embedded-P8-point-without-its-field>
        <#embedded-P9-point-without-a-reading>
        <#embedded-P10-describing-value-on-another-field>
        <#embedded-Q1-summary-with-from>
        <#embedded-Q2-summary-with-until>
        <#embedded-Q3-policy-a-literal>
        <#embedded-Q4-count-a-decimal>
        <#embedded-Q4-count-negative>
        <#embedded-Q5-missing-negative>
        <#embedded-Q6-first-time-a-date>
        <#embedded-Q7-last-time-a-date>
        <#embedded-Q8-observed-minimum-a-string>
        <#embedded-Q9-observed-maximum-a-string>
        <#embedded-Q10-mean-a-string>
        <#embedded-Q11-median-a-string>
        <#embedded-Q12-generated-at-time-a-date>
        <#external-valid-csv>
        <#external-valid-csv-no-header>
        <#external-valid-parquet>
        <#external-valid-arrow>
        <#external-valid-time-grid>
        <#external-valid-time-grid-by-position>
        <#external-valid-delta-from-baseline>
        <#external-valid-open-window>
        <#external-valid-describing-field>
        <#external-valid-about-url>
        <#external-valid-growing-csv>
        <#external-valid-growing-csv-with-range-requests>
        <#external-valid-growing-arrow-stream>
        <#external-valid-growing-parquet>
        <#external-S3-immutable-not-a-boolean>
        <#external-S26-summary-of-a-growing-source>
        <#external-S28-range-requests-on-parquet>
        <#external-S4-time-field-missing>
        <#external-S4-time-field-not-a-field-of-the-source>
        <#external-S5-key-not-the-time-field>
        <#external-S6-no-fields>
        <#external-S7-two-source-classes>
        <#external-S8-data-file-missing>
        <#external-S8-data-file-a-literal>
        <#external-S10-delimiter-two-characters>
        <#external-S11-encoding-empty>
        <#external-S12-label-not-a-literal>
        <#external-S13-produced-by-a-literal>
        <#external-S14-until-before-from>
        <#external-S15-delimiter-on-parquet>
        <#external-S15-encoding-on-arrow>
        <#external-S19-time-base-without-time-step>
        <#external-S18-time-base-a-date>
        <#external-S18-time-step-without-time-base>
        <#external-S19-time-step-zero>
        <#external-S19-time-step-negative>
        <#external-S20-time-field-datatype>
        <#external-S21-step-field-not-an-integer>
        <#external-S21-step-field-without-a-grid>
        <#external-S22-has-point>
        <#external-S22-points>
        <#external-S23-until-without-timezone>
        <#external-S23-time-base-without-timezone>
        <#external-S29-no-value-field>
        <#external-F1-field-of-both-kinds>
        <#external-F1-field-without-a-kind>
        <#external-F2-column-name-missing>
        <#external-F2-duplicate-column-names>
        <#external-F2-grid-time-field-with-a-column-name>
        <#external-F3-datatype-missing>
        <#external-F4-duplicate-column-indexes>
        <#external-F8-maximum-below-minimum>
        <#external-F11-describing-field-a-value-field>
        <#external-F12-context-field-with-a-sensor>
        <#external-F13-two-describing-fields-with-one-property>
        <#external-F14-about-url-an-iri>
        <#external-F15-describing-a-context-field>
        <#external-D1-unknown-value-encoding>
        <#external-D1-delta-without-baseline>
        <#external-D2-baseline-with-another-datatype>
        <#external-D3-baseline-without-value-encoding>
        <#external-D3-value-encoding-on-the-time-field>
        <#external-Q2-summary-with-until>
        <#external-F5-label-not-a-literal>
        <#external-F6-comment-not-a-literal>
        <#external-F7-minimum-not-a-number>
        <#external-F10-summary-a-literal>
        <#external-Q1-summary-with-from>
        <#external-Q3-policy-a-literal>
        <#external-Q4-count-a-decimal>
        <#external-Q4-count-negative>
        <#external-Q5-missing-negative>
        <#external-Q6-first-time-a-date>
        <#external-Q7-last-time-a-date>
        <#external-Q8-observed-minimum-a-string>
        <#external-Q9-observed-maximum-a-string>
        <#external-Q10-mean-a-string>
        <#external-Q11-median-a-string>
        <#external-Q12-generated-at-time-a-date>
        <#external-S2-from-a-date>
        <#mixed-S1-no-source>
        <#mixed-S24-embedded-and-external-sources>
        <#reading-rdf-points>
        <#reading-rdf-points-two-value-fields>
        <#reading-rdf-points-describing-field>
        <#reading-rdf-points-default-property>
        <#reading-json-empty-values>
        <#reading-csv-delimiter>
        <#reading-csv-no-header>
        <#reading-csv-describing-field>
        <#reading-csv-time-window>
        <#reading-csv-time-offsets>
        <#reading-time-grid>
        <#reading-time-grid-by-position>
        <#reading-time-grid-calendar-months>
        <#reading-delta-from-baseline>
        <#reading-texts-kept>
        <#reading-parquet>
        <#reading-arrow>
        <#reading-rdf-message-log>
        <#reading-rdf-message-log-unfinished-message>
        <#reading-rdf-message-log-blank-node-labels>
        <#reading-csv-growing-unfinished-record>
        <#reading-csv-immutable-last-record-without-line-break>
        <#reading-arrow-stream>
        <#reading-error-csv-row-without-time>
        <#reading-error-csv-value-not-in-lexical-form>
        <#reading-error-json-row-without-time>
        <#reading-error-json-value-not-in-lexical-form>
        <#reading-error-rdf-two-points-of-one-field-at-one-time>
        <#reading-error-rdf-point-without-its-field>
        <#summaries-up-to-date>
        <#summaries-out-of-date>
        <#summaries-out-of-date-first-time>
        <#summaries-empty-values>
        <#summaries-same-moment>
        <#summaries-decoded-values>
        <#summaries-window>
        <#expansion-rdf-points>
        <#expansion-two-value-fields>
        <#expansion-empty-values-and-describing-fields>
        <#expansion-time-grid-and-delta>
        <#expansion-about-url>
    ) .

<#embedded-valid-rdf-points> a tsst:MetadataTest ;
    mf:name "embedded-valid-rdf-points" ;
    rdfs:comment "The specification's embedded example: RDF points and a stored summary." ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-tss/#embedded-example> ;
    mf:action <metadata/embedded/valid-rdf-points.ttl> ;
    tsst:shapes "embedded" ;
    tsst:conforms true .

<#embedded-valid-rdf-points-with-their-field> a tsst:MetadataTest ;
    mf:name "embedded-valid-rdf-points-with-their-field" ;
    rdfs:comment "Every point states its value field with tss:field, which it may leave out as the source has one." ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-tss/#rdf-points> ;
    mf:action <metadata/embedded/valid-rdf-points-with-their-field.ttl> ;
    tsst:shapes "embedded" ;
    tsst:conforms true .

<#embedded-valid-two-value-fields> a tsst:MetadataTest ;
    mf:name "embedded-valid-two-value-fields" ;
    rdfs:comment "The specification's multi-sensor example: two value fields, three rows, five points." ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-tss/#meaning> ;
    mf:action <metadata/embedded/valid-two-value-fields.ttl> ;
    tsst:shapes "embedded" ;
    tsst:conforms true .

<#embedded-valid-describing-field> a tsst:MetadataTest ;
    mf:name "embedded-valid-describing-field" ;
    rdfs:comment "The specification's describing-field example: a status stated with its tss:property." ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-tss/#describing> ;
    mf:action <metadata/embedded/valid-describing-field.ttl> ;
    tsst:shapes "embedded" ;
    tsst:conforms true .

<#embedded-valid-describing-field-default-property> a tsst:MetadataTest ;
    mf:name "embedded-valid-describing-field-default-property" ;
    rdfs:comment "A describing field without tss:property: its default property is the document IRI, '#' and its column name." ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-tss/#point-values> ;
    mf:action <metadata/embedded/valid-describing-field-default-property.ttl> ;
    tsst:shapes "embedded" ;
    tsst:conforms true .

<#embedded-valid-json-rows> a tsst:MetadataTest ;
    mf:name "embedded-valid-json-rows" ;
    rdfs:comment "The same readings as JSON rows." ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-tss/#json-points> ;
    mf:action <metadata/embedded/valid-json-rows.ttl> ;
    tsst:shapes "embedded" ;
    tsst:conforms true .

<#embedded-valid-open-window> a tsst:MetadataTest ;
    mf:name "embedded-valid-open-window" ;
    rdfs:comment "A source without tss:from and tss:until: the window is open on both sides." ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-tss/#window> ;
    mf:action <metadata/embedded/valid-open-window.ttl> ;
    tsst:shapes "embedded" ;
    tsst:conforms true .

<#embedded-valid-times-with-offsets> a tsst:MetadataTest ;
    mf:name "embedded-valid-times-with-offsets" ;
    rdfs:comment "A point's time with an offset instead of Z." ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-tss/#times> ;
    mf:action <metadata/embedded/valid-times-with-offsets.ttl> ;
    tsst:shapes "embedded" ;
    tsst:conforms true .

<#embedded-valid-date-time-stamp> a tsst:MetadataTest ;
    mf:name "embedded-valid-date-time-stamp" ;
    rdfs:comment "Every time as an xsd:dateTimeStamp, which says the same as an xsd:dateTime with a timezone." ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-tss/#times> ;
    mf:action <metadata/embedded/valid-date-time-stamp.ttl> ;
    tsst:shapes "embedded" ;
    tsst:conforms true .

<#embedded-valid-empty-text-is-no-value> a tsst:MetadataTest ;
    mf:name "embedded-valid-empty-text-is-no-value" ;
    rdfs:comment "An empty text (\"\") of a describing field is no value, so the point has no status." ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-tss/#points> ;
    mf:action <metadata/embedded/valid-empty-text-is-no-value.ttl> ;
    tsst:shapes "embedded" ;
    tsst:conforms true .

<#embedded-P9-point-with-an-empty-reading> a tsst:MetadataTest ;
    mf:name "embedded-P9-point-with-an-empty-reading" ;
    rdfs:comment "A point whose reading is the empty text: an empty text is no value, so the point has no reading." ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-tss/#rdf-points> ;
    mf:action <metadata/embedded/P9-point-with-an-empty-reading.ttl> ;
    tsst:shapes "embedded" ;
    tsst:conforms false ;
    tsst:violation "P9" .

<#embedded-valid-no-points-yet> a tsst:MetadataTest ;
    mf:name "embedded-valid-no-points-yet" ;
    rdfs:comment "A source may have no rows yet." ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-tss/#rdf-points> ;
    mf:action <metadata/embedded/valid-no-points-yet.ttl> ;
    tsst:shapes "embedded" ;
    tsst:conforms true .

<#embedded-valid-empty-json-array> a tsst:MetadataTest ;
    mf:name "embedded-valid-empty-json-array" ;
    rdfs:comment "\"[]\" holds no rows." ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-tss/#json-points> ;
    mf:action <metadata/embedded/valid-empty-json-array.ttl> ;
    tsst:shapes "embedded" ;
    tsst:conforms true .

<#embedded-valid-growing-json-rows> a tsst:MetadataTest ;
    mf:name "embedded-valid-growing-json-rows" ;
    rdfs:comment "A growing source: it states no tss:immutable, and has no summary." ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-tss/#change> ;
    mf:action <metadata/embedded/valid-growing-json-rows.ttl> ;
    tsst:shapes "embedded" ;
    tsst:conforms true .

<#embedded-valid-growing-message-log> a tsst:MetadataTest ;
    mf:name "embedded-valid-growing-message-log" ;
    rdfs:comment "A growing tss:EmbeddedRDFSource: an RDF Message Log, one row per message, no summary." ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-tss/#rdf-points> ;
    mf:action <metadata/embedded/valid-growing-message-log.ttl> ;
    tsst:shapes "embedded" ;
    tsst:conforms true .

<#embedded-valid-ended-message-log> a tsst:MetadataTest ;
    mf:name "embedded-valid-ended-message-log" ;
    rdfs:comment "A log whose last message ends the source: tss:immutable true and the summary." ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-tss/#ending> ;
    mf:action <metadata/embedded/valid-ended-message-log.ttl> ;
    tsst:shapes "embedded" ;
    tsst:conforms true .

<#embedded-valid-range-requests> a tsst:MetadataTest ;
    mf:name "embedded-valid-range-requests" ;
    rdfs:comment "A growing RDF Message Log whose publisher promises that it only grows, byte for byte." ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-tss/#range-opt-in> ;
    mf:action <metadata/embedded/valid-range-requests.ttl> ;
    tsst:shapes "embedded" ;
    tsst:conforms true .

<#embedded-S2-immutable-not-a-boolean> a tsst:MetadataTest ;
    mf:name "embedded-S2-immutable-not-a-boolean" ;
    rdfs:comment "tss:immutable is the string \"yes\", not an xsd:boolean (so the source is growing, and its summary is S26)." ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-tss/#change> ;
    mf:action <metadata/embedded/S2-immutable-not-a-boolean.ttl> ;
    tsst:shapes "embedded" ;
    tsst:conforms false ;
    tsst:violation "S2" ;
    tsst:violation "S26" .

<#embedded-S2-two-immutable-values> a tsst:MetadataTest ;
    mf:name "embedded-S2-two-immutable-values" ;
    rdfs:comment "The source states tss:immutable twice." ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-tss/#change> ;
    mf:action <metadata/embedded/S2-two-immutable-values.ttl> ;
    tsst:shapes "embedded" ;
    tsst:conforms false ;
    tsst:violation "S2" .

<#embedded-S26-summary-of-a-growing-source> a tsst:MetadataTest ;
    mf:name "embedded-S26-summary-of-a-growing-source" ;
    rdfs:comment "A growing source (no tss:immutable) with a stored summary." ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-tss/#summaries> ;
    mf:action <metadata/embedded/S26-summary-of-a-growing-source.ttl> ;
    tsst:shapes "embedded" ;
    tsst:conforms false ;
    tsst:violation "S26" .

<#embedded-S26-summary-with-immutable-false> a tsst:MetadataTest ;
    mf:name "embedded-S26-summary-with-immutable-false" ;
    rdfs:comment "A source that states tss:immutable false, with a stored summary." ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-tss/#summaries> ;
    mf:action <metadata/embedded/S26-summary-with-immutable-false.ttl> ;
    tsst:shapes "embedded" ;
    tsst:conforms false ;
    tsst:violation "S26" .

<#embedded-S28-range-requests-on-json-rows> a tsst:MetadataTest ;
    mf:name "embedded-S28-range-requests-on-json-rows" ;
    rdfs:comment "A tss:EmbeddedJSONSource states tss:rangeRequests true: a Write writes its tss:points anew." ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-tss/#range-opt-in> ;
    mf:action <metadata/embedded/S28-range-requests-on-json-rows.ttl> ;
    tsst:shapes "embedded" ;
    tsst:conforms false ;
    tsst:violation "S28" .

<#embedded-S3-two-source-classes> a tsst:MetadataTest ;
    mf:name "embedded-S3-two-source-classes" ;
    rdfs:comment "The source states two source classes." ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-tss/#storage> ;
    mf:action <metadata/embedded/S3-two-source-classes.ttl> ;
    tsst:shapes "embedded" ;
    tsst:conforms false ;
    tsst:violation "S3" .

<#embedded-S4-time-field-missing> a tsst:MetadataTest ;
    mf:name "embedded-S4-time-field-missing" ;
    rdfs:comment "The source has no tss:timeField." ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-tss/#time-and-key> ;
    mf:action <metadata/embedded/S4-time-field-missing.ttl> ;
    tsst:shapes "embedded" ;
    tsst:conforms false ;
    tsst:violation "S4" .

<#embedded-S4-time-field-not-a-field-of-the-source> a tsst:MetadataTest ;
    mf:name "embedded-S4-time-field-not-a-field-of-the-source" ;
    rdfs:comment "The time field is not one of the source's fields." ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-tss/#time-and-key> ;
    mf:action <metadata/embedded/S4-time-field-not-a-field-of-the-source.ttl> ;
    tsst:shapes "embedded" ;
    tsst:conforms false ;
    tsst:violation "S4" .

<#embedded-S5-no-fields> a tsst:MetadataTest ;
    mf:name "embedded-S5-no-fields" ;
    rdfs:comment "The source has no tss:hasField." ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-tss/#fields> ;
    mf:action <metadata/embedded/S5-no-fields.ttl> ;
    tsst:shapes "embedded" ;
    tsst:conforms false ;
    tsst:violation "S5" .

<#embedded-S6-point-not-linked-to-its-source> a tsst:MetadataTest ;
    mf:name "embedded-S6-point-not-linked-to-its-source" ;
    rdfs:comment "A node with a time and a reading that the source does not link to with tss:hasPoint." ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-tss/#rdf-points> ;
    mf:action <metadata/embedded/S6-point-not-linked-to-its-source.ttl> ;
    tsst:shapes "embedded" ;
    tsst:conforms false ;
    tsst:violation "S6" .

<#embedded-S6-json-points-not-rdf-json> a tsst:MetadataTest ;
    mf:name "embedded-S6-json-points-not-rdf-json" ;
    rdfs:comment "tss:points is a plain string, not an rdf:JSON literal." ;
    tsst:rule <https://knowledgeonwebscale.github.io/rdf-tss/#json-points> ;

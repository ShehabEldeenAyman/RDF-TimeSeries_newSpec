@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix tss: <https://w3id.org/tss#> .
@prefix ex: <https://example.org/ex#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix quantitykind: <http://qudt.org/vocab/quantitykind/> .
@prefix unit: <http://qudt.org/vocab/unit/> .

# An RDF Time Series Sources (RDF-TSS) metadata document: https://knowledgeonwebscale.github.io/rdf-tss/
# Logical datatypes interpret CSV and embedded-point lexical values; native types stay in the file.
# Source windows are [from, until).
# tss:key is the time field: no two rows have the same time.
# tss:columnIndex is optional when tss:columnName identifies a field; indices are zero-based.
# RDFS/catalog annotations and external datatype/unit identifiers are retained.

# The 46 Zevenaarshaven readings of the selection [2021-03-03T23:15:00Z, 2021-03-05T00:00:00Z),
# in a Parquet file written by evaluation/waterinfo/to_parquet.py from data/waterinfo_289441042.csv,
# with native Parquet types (ts_id INT64, Timestamp TIMESTAMP in UTC microseconds, Value DOUBLE,
# the two codes INT64, the texts STRING).
# The source and its fields have their own IRIs (ex:zevenaarshaven-parquet-...); the sensor, the
# feature of interest and the station (ex:289441042) are those of the other Zevenaarshaven documents.

# Shared source: provenance, time window, time field and column schema.

ex:zevenaarshaven-parquet-source
    a tss:ParquetSource ;
    rdfs:label "Waterinfo EC20, Kanaal Gent-Terneuzen Zevenaarshaven (NL), Parquet"@en ;
    # Optional tss:sourceDescription; publishers may use any RDF vocabulary and properties.
    tss:sourceDescription [
        dcterms:spatial [
            a dcterms:Location ;
            rdfs:label "Kanaal Gent-Terneuzen Zevenaarshaven (NL)"@en
        ]
    ] ;
    # Immutable: final, no reading is added any more. Only an immutable source has stored summaries.
    tss:immutable true ;
    tss:producedBy ex:289441042 ;
    tss:from "2021-03-03T23:15:00Z"^^xsd:dateTime ;
    tss:until "2021-03-05T00:00:00Z"^^xsd:dateTime ;
    tss:dataFile <https://shehabeldeenayman.github.io/RDF-TimeSeries_newSpec/data/waterinfo_289441042.parquet> ;
    # The "Timestamp" column of the data file is a native Parquet timestamp (UTC, in
    # microseconds, all whole seconds), read as xsd:dateTime.
    tss:timeField ex:zevenaarshaven-parquet-time-field ;
    tss:key ex:zevenaarshaven-parquet-time-field ;
    tss:hasField ex:zevenaarshaven-parquet-ts_id-field,
        ex:zevenaarshaven-parquet-time-field,
        ex:zevenaarshaven-parquet-ec20-field,
        ex:zevenaarshaven-parquet-interpolation-type-field,
        ex:zevenaarshaven-parquet-quality-code-field,
        ex:zevenaarshaven-parquet-quality-code-name-field,
        ex:zevenaarshaven-parquet-quality-code-description-field,
        ex:zevenaarshaven-parquet-quality-code-color-field .

# Field definitions include measurement meaning, units, sensor and feature.
# Optional tss:fieldDescription records use Dublin Core here; any RDF vocabulary may be used.

# Generated column summaries (calculated from the actual data, not example values).
# Each summary covers the existing rows/points in the source's window [tss:from, tss:until);
# a summary has no window of its own.
# tss:ExcludeEmptyValues excludes nulls, absent keys and empty strings ("");
# whitespace-only strings are not treated as empty. tss:count counts present values;
# tss:missing counts empty values in existing rows, not absent timestamps or time gaps.
# tss:firstTime / tss:lastTime are the first/last timestamps with a present field value.
# Numeric aggregates are for conductivity fields, in their declared units if known.
# Mean is the unweighted arithmetic mean; median averages the middle two values for even counts.
# All present readings are included regardless of quality codes or the expected range.
# Observed extrema do not replace the expected tss:minimum / tss:maximum range.
# For embedded data these summaries describe only the supplied sample points.
# tss:generatedAtTime records when they were calculated: once, from the final readings.

ex:zevenaarshaven-parquet-ts_id-field
    a tss:ContextField ;
    tss:columnName "ts_id" ;
    rdfs:label "ts_id"@en ;
    tss:datatype xsd:integer ;
    rdfs:comment "waterinfo.be time series identifier (the same on every row)"@en ;
    tss:fieldDescription [
        dcterms:description "waterinfo.be time series identifier (the same on every row)"@en
    ] ;
    tss:summary [
        tss:missingValuePolicy tss:ExcludeEmptyValues ;
        tss:count "46"^^xsd:integer ;
        tss:missing "0"^^xsd:integer ;
        tss:firstTime "2021-03-03T23:15:00+00:00"^^xsd:dateTime ;
        tss:lastTime "2021-03-04T23:00:00+00:00"^^xsd:dateTime ;
        tss:generatedAtTime "2026-11-27T19:03:30+00:00"^^xsd:dateTime
    ] .

ex:zevenaarshaven-parquet-time-field
    a tss:ContextField ;
    tss:columnName "Timestamp" ;
    rdfs:label "Timestamp"@en ;
    tss:datatype xsd:dateTime ;
    rdfs:comment "Observation time (UTC)"@en ;
    tss:fieldDescription [
        dcterms:description "Observation time (UTC)"@en
    ] ;
    tss:summary [
        tss:missingValuePolicy tss:ExcludeEmptyValues ;
        tss:count "46"^^xsd:integer ;
        tss:missing "0"^^xsd:integer ;
        tss:firstTime "2021-03-03T23:15:00+00:00"^^xsd:dateTime ;
        tss:lastTime "2021-03-04T23:00:00+00:00"^^xsd:dateTime ;
        tss:generatedAtTime "2026-11-27T19:03:30+00:00"^^xsd:dateTime
    ] .

ex:zevenaarshaven-parquet-ec20-field
    a tss:ValueField ;
    tss:columnName "Value" ;
    rdfs:label "Electrical conductivity at 20 °C, Kanaal Gent-Terneuzen Zevenaarshaven (NL)"@en ;
    tss:datatype xsd:double ;
    rdfs:comment "Electrical conductivity at 20 °C"@en ;
    tss:minimum 0 ;
    # Example only: 10000 is a placeholder, not a real validated upper limit.
    tss:maximum "10000"^^xsd:double ;
    tss:observedProperty quantitykind:ElectricConductivity ;
    tss:unit unit:MicroS-PER-CentiM ;
    tss:sensor ex:sensor-zevenaarshaven-ec20 ;
    tss:featureOfInterest ex:water-zevenaarshaven ;
    tss:fieldDescription [
        dcterms:description "Electrical conductivity at 20 °C"@en ;
        dcterms:subject quantitykind:ElectricConductivity ;
        dcterms:relation ex:sensor-zevenaarshaven-ec20, ex:water-zevenaarshaven
    ] ;
    tss:summary [
        tss:missingValuePolicy tss:ExcludeEmptyValues ;
        tss:count "46"^^xsd:integer ;
        tss:missing "0"^^xsd:integer ;
        tss:firstTime "2021-03-03T23:15:00+00:00"^^xsd:dateTime ;
        tss:lastTime "2021-03-04T23:00:00+00:00"^^xsd:dateTime ;
        tss:observedMinimum "4457.92"^^xsd:double ;
        tss:observedMaximum "4883.63"^^xsd:double ;
        tss:mean "4644.840434782609"^^xsd:double ;
        tss:median "4640.1849999999995"^^xsd:double ;
        tss:generatedAtTime "2026-11-27T19:03:30+00:00"^^xsd:dateTime
    ] .


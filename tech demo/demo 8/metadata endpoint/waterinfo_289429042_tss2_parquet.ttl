@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix tss: <https://w3id.org/tss#> .
@prefix ex: <https://example.org/ex#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix quantitykind: <http://qudt.org/vocab/quantitykind/> .
@prefix unit: <http://qudt.org/vocab/unit/> .

# Demo 7: experimental RDF time-series schema with field-level source locators.
# The new TSS schema, field, source and locator terms are proposal vocabulary.
# Logical datatypes interpret CSV and embedded-point lexical values; native types stay in the file.
# Source windows are [from, until).
# tss:key identifies the field whose values uniquely identify a row.
# tss:columnIndex is optional when tss:columnName identifies a field; indices are zero-based.
# RDFS/catalog annotations and external datatype/unit identifiers are retained.

# Shared source: provenance, time window, time field and column schema.

ex:rodenhuizedok-source
    a tss:Source ;
    # Last edit of the source metadata; summary calculation times are separate.
    tss:modifiedAt "2026-10-26T11:43:43Z"^^xsd:dateTime ;
    rdfs:label "Waterinfo EC20, Kanaal Gent-Terneuzen Rodenhuizedok (BE)"@en ;
    # Optional tss:sourceDescription; publishers may use any RDF vocabulary and properties.
    tss:sourceDescription [
        dcterms:spatial [
            a dcterms:Location ;
            rdfs:label "Kanaal Gent-Terneuzen Rodenhuizedok (BE)"@en
        ]
    ] ;
    tss:mutable false ;
    tss:producedBy ex:station-rodenhuizedok ;
    tss:from "2021-03-03T23:15:00Z"^^xsd:dateTime ;
    tss:until "2026-01-01T00:00:00Z"^^xsd:dateTime ;
    # Committed until: the last time the source and its data were checked to be up to date.
    tss:committedUntil "2026-10-26T11:43:43Z"^^xsd:dateTime ;
    tss:embedded false ;
    tss:dataFile <../data/waterinfo_289429042.parquet> ;
    tss:format tss:Parquet ;
    tss:timeField ex:rodenhuizedok-time-field ;
    tss:key ex:rodenhuizedok-time-field ;
    tss:hasField ex:rodenhuizedok-ts_id-field,
        ex:rodenhuizedok-time-field,
        ex:rodenhuizedok-ec20-field,
        ex:rodenhuizedok-interpolation-type-field,
        ex:rodenhuizedok-quality-code-field,
        ex:rodenhuizedok-quality-code-name-field,
        ex:rodenhuizedok-quality-code-description-field,
        ex:rodenhuizedok-quality-code-color-field .

# Field definitions include measurement meaning, units, sensor and feature.
# Optional tss:fieldDescription records use Dublin Core here; any RDF vocabulary may be used.

# Generated column summaries (calculated from the actual data, not example values).
# Each summary covers existing rows/points in [tss:from, tss:until) only.
# tss:ExcludeEmptyValues excludes nulls, absent keys and empty strings ("");
# whitespace-only strings are not treated as empty. tss:count counts present values;
# tss:missing counts empty values in existing rows, not absent timestamps or time gaps.
# tss:firstTime / tss:lastTime are the first/last timestamps with a present field value.
# Numeric aggregates are for conductivity fields, in their declared units if known.
# Mean is the unweighted arithmetic mean; median averages the middle two values for even counts.
# All present readings are included regardless of quality codes or allowed bounds.
# Observed extrema do not replace the allowed tss:minimum / tss:maximum bounds.
# For embedded data these summaries describe only the supplied sample points.
# prov:generatedAtTime records calculation time; summaries are not refreshed automatically.

ex:rodenhuizedok-ts_id-field
    a tss:Field ;
    tss:columnName "ts_id" ;
    rdfs:label "ts_id"@en ;
    tss:datatype xsd:integer ;
    rdfs:comment "Waterinfo time series identifier (the same on every row)."@en ;
    tss:fieldDescription [
        dcterms:description "Waterinfo time series identifier (the same on every row)."@en
    ] ;
    tss:summary [
        tss:from "2021-03-03T23:15:00+00:00"^^xsd:dateTime ;
        tss:until "2026-01-01T00:00:00+00:00"^^xsd:dateTime ;
        tss:missingValuePolicy tss:ExcludeEmptyValues ;
        tss:count "158022"^^xsd:integer ;
        tss:missing "0"^^xsd:integer ;
        tss:firstTime "2021-03-03T23:15:00+00:00"^^xsd:dateTime ;
        tss:lastTime "2025-12-31T23:45:00+00:00"^^xsd:dateTime ;
        prov:generatedAtTime "2026-10-22T14:02:30+00:00"^^xsd:dateTime
    ] .

ex:rodenhuizedok-time-field
    a tss:Field ;
    tss:columnName "Timestamp" ;
    rdfs:label "Timestamp"@en ;
    tss:datatype xsd:dateTime ;
    rdfs:comment "Observation time (UTC)."@en ;
    tss:fieldDescription [
        dcterms:description "Observation time (UTC)."@en
    ] ;
    tss:summary [
        tss:from "2021-03-03T23:15:00+00:00"^^xsd:dateTime ;
        tss:until "2026-01-01T00:00:00+00:00"^^xsd:dateTime ;
        tss:missingValuePolicy tss:ExcludeEmptyValues ;
        tss:count "158022"^^xsd:integer ;
        tss:missing "0"^^xsd:integer ;
        tss:firstTime "2021-03-03T23:15:00+00:00"^^xsd:dateTime ;
        tss:lastTime "2025-12-31T23:45:00+00:00"^^xsd:dateTime ;
        prov:generatedAtTime "2026-10-22T14:02:30+00:00"^^xsd:dateTime
    ] .

ex:rodenhuizedok-ec20-field
    a tss:Field ;
    tss:columnName "Value" ;
    rdfs:label "Electrical conductivity at 20 °C, Kanaal Gent-Terneuzen Rodenhuizedok (BE)"@en ;
    tss:datatype xsd:double ;
    tss:minimum "0"^^xsd:double ;
    # Example only: 10000 is a placeholder, not a real validated upper limit.
    tss:maximum "10000"^^xsd:double ;
    rdfs:comment "Electrical conductivity corrected to 20 degrees Celsius."@en ;
    tss:observedProperty quantitykind:ElectricConductivity ;
    tss:unit unit:MicroS-PER-CentiM ;
    tss:sensor ex:sensor-rodenhuizedok-ec20 ;
    tss:featureOfInterest ex:water-rodenhuizedok ;
    tss:fieldDescription [
        dcterms:description "Electrical conductivity corrected to 20 degrees Celsius."@en ;
        dcterms:subject quantitykind:ElectricConductivity ;
        dcterms:relation ex:sensor-rodenhuizedok-ec20, ex:water-rodenhuizedok
    ] ;
    tss:summary [
        tss:from "2021-03-03T23:15:00+00:00"^^xsd:dateTime ;
        tss:until "2026-01-01T00:00:00+00:00"^^xsd:dateTime ;
        tss:missingValuePolicy tss:ExcludeEmptyValues ;
        tss:count "158022"^^xsd:integer ;
        tss:missing "0"^^xsd:integer ;
        tss:firstTime "2021-03-03T23:15:00+00:00"^^xsd:dateTime ;
        tss:lastTime "2025-12-31T23:45:00+00:00"^^xsd:dateTime ;
        tss:observedMinimum "475.51"^^xsd:double ;
        tss:observedMaximum "19526.76"^^xsd:double ;
        tss:mean "6334.6262085658955"^^xsd:double ;
        tss:median "5531.94"^^xsd:double ;
        prov:generatedAtTime "2026-10-22T14:02:30+00:00"^^xsd:dateTime
    ] .


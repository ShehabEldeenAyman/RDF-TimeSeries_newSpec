@prefix tss: <https://w3id.org/tss#> .
@prefix ex: <https://example.org/ex#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix quantitykind: <http://qudt.org/vocab/quantitykind/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# Demo 6: experimental RDF time-series schema with field-level source locators.
# The new TSS schema, field, source and locator terms are proposal vocabulary.
# Logical datatypes interpret CSV/JSON lexical values; native types stay in the file.
# Snippet windows are [from, until). CSV column indices are zero-based.
# RDFS/catalog annotations and external datatype/unit identifiers are retained.

# Group identity and provenance; each snippet explicitly identifies its source.

ex:grootdok-snippets
    a tss:SnippetGroup ;
    rdfs:label "Waterinfo EC20, Kanaal Gent-Terneuzen Grootdok (BE)"@en ;
    tss:embedded false ;
    tss:mutable false ;
    tss:producedBy ex:station-grootdok ;
    tss:hasSnippet ex:snippet-grootdok-ec20 .

# Physical source; its schema fields specify their physical locations.

ex:grootdok-source
    a tss:Source ;
    tss:embedded false ;
    tss:dataFile <../data/waterinfo_289423042.csv> ;
    tss:format tss:CSV ;
    tss:schema [
        a tss:Schema ;
        tss:hasField ex:grootdok-ts_id-field,
            ex:grootdok-time-field,
            ex:grootdok-ec20-field,
            ex:grootdok-interpolation-type-field,
            ex:grootdok-quality-code-field,
            ex:grootdok-quality-code-name-field,
            ex:grootdok-quality-code-description-field,
            ex:grootdok-quality-code-color-field ;
        tss:primaryKey ex:grootdok-time-field
    ] ;
    tss:delimiter "," ;
    tss:header true ;
    tss:encoding "utf-8" ;
    dcterms:title "Waterinfo EC20, Kanaal Gent-Terneuzen Grootdok (BE)" ;
    dcterms:description "Electrical conductivity at 20 °C in µS/cm, 15-minute values, from waterinfo.be time series 289423042 (station HIS_BWO_VITO_IOW48), 2021-03-03 to 2025-12-18." .

# Field definitions; units and measurement meaning belong to fields.

ex:grootdok-ts_id-field
    a tss:Field ;
    tss:columnName "ts_id" ;
    tss:columnIndex 0 ;
    rdfs:label "ts_id"@en ;
    tss:datatype xsd:integer ;
    rdfs:comment "waterinfo.be time series identifier (the same on every row)"@en ;
    tss:required true .

ex:grootdok-time-field
    a tss:Field ;
    tss:columnName "Timestamp" ;
    tss:columnIndex 1 ;
    rdfs:label "Timestamp"@en ;
    tss:datatype xsd:dateTime ;
    rdfs:comment "Observation time (UTC)"@en ;
    tss:required true .

ex:grootdok-ec20-field
    a tss:Field ;
    tss:columnName "Value" ;
    tss:columnIndex 2 ;
    rdfs:label "Value"@en ;
    tss:datatype xsd:double ;
    rdfs:comment "Electrical conductivity at 20 °C"@en ;
    tss:required true ;
    tss:minimum 0 ;
    tss:observedProperty quantitykind:ElectricConductivity ;
    tss:unit unit:MicroS-PER-CentiM .

ex:grootdok-interpolation-type-field
    a tss:Field ;
    tss:columnName "Interpolation Type" ;
    tss:columnIndex 3 ;
    rdfs:label "Interpolation Type"@en ;
    tss:datatype xsd:integer ;
    rdfs:comment "KiWIS interpolation type code of the value"@en ;
    tss:describesField ex:grootdok-ec20-field .

ex:grootdok-quality-code-field
    a tss:Field ;
    tss:columnName "Quality Code" ;
    tss:columnIndex 4 ;
    rdfs:label "Quality Code"@en ;
    tss:datatype xsd:integer ;
    rdfs:comment "KiWIS quality code of the value"@en ;
    tss:describesField ex:grootdok-ec20-field .

ex:grootdok-quality-code-name-field
    a tss:Field ;
    tss:columnName "Quality Code Name" ;
    tss:columnIndex 5 ;
    rdfs:label "Quality Code Name"@en ;
    tss:datatype xsd:string ;
    rdfs:comment "Short name of the quality code"@en ;
    tss:describesField ex:grootdok-ec20-field .

ex:grootdok-quality-code-description-field
    a tss:Field ;
    tss:columnName "Quality Code Description" ;
    tss:columnIndex 6 ;
    rdfs:label "Quality Code Description"@en ;
    tss:datatype xsd:string ;
    rdfs:comment "Description of the quality code"@en ;
    tss:describesField ex:grootdok-ec20-field .

ex:grootdok-quality-code-color-field
    a tss:Field ;
    tss:columnName "Quality Code Color" ;
    tss:columnIndex 7 ;
    rdfs:label "Quality Code Color"@en ;
    tss:datatype xsd:string ;
    rdfs:comment "Display colour of the quality code (RGBA)"@en ;
    tss:describesField ex:grootdok-ec20-field .

# Snippets select fields and retain their original identities and time windows.

ex:snippet-grootdok-ec20
    a tss:Snippet ;
    rdfs:label "Electrical conductivity at 20 °C, Kanaal Gent-Terneuzen Grootdok (BE)"@en ;
    tss:source ex:grootdok-source ;
    tss:timeField ex:grootdok-time-field ;
    tss:valueField ex:grootdok-ec20-field ;
    tss:from "2021-03-03T23:45:00Z"^^xsd:dateTime ;
    tss:until "2025-12-18T23:15:00Z"^^xsd:dateTime ;
    tss:sensor ex:sensor-grootdok-ec20 ;
    tss:featureOfInterest ex:water-grootdok .

@prefix tss: <https://w3id.org/tss#> .
@prefix ex: <https://example.org/ex#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix quantitykind: <http://qudt.org/vocab/quantitykind/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .

# Demo 6: experimental RDF time-series schema with field-level source locators.
# The new TSS schema, field, source and locator terms are proposal vocabulary.
# Logical datatypes interpret CSV/JSON lexical values; native types stay in the file.
# Source windows are [from, until).
# tss:key identifies the field whose values uniquely identify a row.
# tss:columnIndex is optional when tss:columnName identifies a field; indices are zero-based.
# RDFS/catalog annotations and external datatype/unit identifiers are retained.

# Shared source: provenance, time window, time field and column schema.

ex:factory-source
    a tss:Source ;
    rdfs:label "Factory water conductivity, 2025"@en ;
    tss:mutable false ;
    tss:producedBy ex:system1 ;
    tss:from "2025-01-01T00:00:00Z"^^xsd:dateTime ;
    tss:until "2026-01-01T00:00:00Z"^^xsd:dateTime ;
    tss:embedded false ;
    tss:dataFile <../data/factory_conductivity.csv> ;
    tss:format tss:CSV ;
    tss:timeField ex:factory-time-field ;
    tss:key ex:factory-time-field ;
    tss:hasField ex:factory-time-field,
        ex:factory-ro1_a_permeate_conductivity-field,
        ex:factory-ro1_b_permeate_conductivity-field,
        ex:factory-ro1_c_permeate_conductivity-field,
        ex:factory-ro2_a_permeate_conductivity-field,
        ex:factory-ro2_b_permeate_conductivity-field,
        ex:factory-cooling_water_conductivity-field,
        ex:factory-boiler_feed_conductivity-field,
        ex:factory-boiler_water_delivery_conductivity-field,
        ex:factory-dockwater_blowdown_conductivity-field,
        ex:factory-venturi_reject_conductivity-field,
        ex:factory-ro1de_feed_conductivity-field,
        ex:factory-ro1d_feed_conductivity-field,
        ex:factory-ro1e_feed_conductivity-field ;
    tss:delimiter ";" ;
    tss:header true ;
    tss:encoding "utf-8" ;
    dcterms:publisher <https://www.ugent.be/> ;
    dcterms:license <https://example.org/license-to-be-decided> ;
    dcterms:issued "2026-09-25"^^xsd:date ;
    dcterms:modified "2026-09-28"^^xsd:date ;
    prov:wasDerivedFrom [ rdfs:label "Confidential industrial water-treatment sensor export (not published)" ; dcterms:temporal "2025-01-01/2025-12-31"^^xsd:string ] ;
    prov:wasGeneratedBy [ rdf:type prov:Activity ; rdfs:label "Selected conductivity columns, renamed them, and multiplied each value by an independent random factor 1 + N(0, 0.02), clipped at 0. The noise is unseeded and cannot be reproduced." ; prov:endedAtTime "2026-09-25T00:00:00Z"^^xsd:dateTime ] .



# Field definitions include measurement meaning, units, sensor and feature.

ex:factory-time-field
    a tss:Field ;
    tss:columnName "datetime" ;
    tss:columnIndex 0 ;
    rdfs:label "datetime"@en ;
    tss:datatype xsd:dateTime ;
    rdfs:comment "Observation time (UTC), 15-minute resolution"@en ;
    tss:required true .

ex:factory-ro1_a_permeate_conductivity-field
    a tss:Field ;
    tss:columnName "ro1_a_permeate_conductivity" ;
    tss:columnIndex 1 ;
    rdfs:label "RO1 train A permeate conductivity, 2025"@en ;
    tss:datatype xsd:double ;
    rdfs:comment "Permeate conductivity of reverse-osmosis unit RO1 train A"@en ;
    tss:minimum 0 ;
    # Example only: 10000 is a placeholder, not a real validated upper limit.
    tss:maximum "10000"^^xsd:double ;
    tss:observedProperty quantitykind:ElectricConductivity ;
    tss:unit unit:MicroS-PER-CentiM ;
    tss:sensor ex:sensor-ro1_a_permeate ;
    tss:featureOfInterest ex:ro1_a_permeate .

ex:factory-ro1_b_permeate_conductivity-field
    a tss:Field ;
    tss:columnName "ro1_b_permeate_conductivity" ;
    tss:columnIndex 2 ;
    rdfs:label "RO1 train B permeate conductivity, 2025"@en ;

@prefix tss: <https://w3id.org/tss#> .
@prefix ex: <https://example.org/ex#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix quantitykind: <http://qudt.org/vocab/quantitykind/> .
@prefix unit: <http://qudt.org/vocab/unit/> .

# Demo 6: experimental RDF time-series schema with field-level source locators.
# The new TSS schema, field, source and locator terms are proposal vocabulary.
# Logical datatypes interpret CSV/JSON lexical values; native types stay in the file.
# Snippet windows are [from, until). CSV column indices are zero-based.
# RDFS/catalog annotations and external datatype/unit identifiers are retained.

# Group identity and provenance; each snippet explicitly identifies its source.

ex:zevenaarshaven-snippets
    a tss:SnippetGroup ;
    rdfs:label "Waterinfo EC20, Kanaal Gent-Terneuzen Zevenaarshaven (NL)"@en ;
    tss:embedded true ;
    tss:mutable false ;
    tss:producedBy ex:289441042 ;
    tss:hasSnippet ex:snippet-zevenaarshaven-ec20,
        ex:snippet-zevenaarshaven-quality-code-color .

# Embedded object keys are declared on fields; object ordering has no meaning.

ex:zevenaarshaven-ec20-source
    a tss:Source ;
    tss:embedded true ;
    tss:format tss:JSON ;
    tss:schema ex:zevenaarshaven-ec20-schema ;
    tss:pointLayout tss:Object ;
    tss:points """[
        { "time": "2021-03-03T23:15:00Z", "value": "4797.72"},
        { "time": "2021-03-03T23:30:00Z", "value": "4717.8"},
        { "time": "2021-03-03T23:45:00Z", "value": "4745.36"},
        { "time": "2021-03-04T00:30:00Z", "value": "4716.1"},
        { "time": "2021-03-04T01:00:00Z", "value": "4775.96"}
      ]"""^^rdf:JSON .

ex:zevenaarshaven-ec20-schema
    a tss:Schema ;
    tss:hasField ex:zevenaarshaven-ec20-time-field,
        ex:zevenaarshaven-ec20-value-field .

ex:zevenaarshaven-ec20-time-field
    a tss:Field ;
    tss:key "time" ;
    rdfs:label "Observation time"@en ;
    tss:datatype xsd:dateTime ;
    tss:required true .

ex:zevenaarshaven-ec20-value-field
    a tss:Field ;
    tss:key "value" ;
    rdfs:label "Electrical conductivity at 20 °C, Kanaal Gent-Terneuzen Zevenaarshaven (NL)"@en ;
    tss:datatype xsd:double ;
    tss:observedProperty quantitykind:ElectricConductivity ;
    tss:unit unit:MicroS-PER-CentiM .

ex:snippet-zevenaarshaven-ec20
    a tss:Snippet ;
    rdfs:label "Electrical conductivity at 20 °C, Kanaal Gent-Terneuzen Zevenaarshaven (NL)"@en ;
    tss:source ex:zevenaarshaven-ec20-source ;
    tss:timeField ex:zevenaarshaven-ec20-time-field ;
    tss:valueField ex:zevenaarshaven-ec20-value-field ;
    tss:from "2021-03-03T23:15:00Z"^^xsd:dateTime ;
    tss:until "2026-01-01T00:00:00Z"^^xsd:dateTime ;
    tss:sensor ex:sensor-zevenaarshaven-ec20 ;
    tss:featureOfInterest ex:water-zevenaarshaven .

# Embedded object keys are declared on fields; object ordering has no meaning.

ex:zevenaarshaven-quality-color-source
    a tss:Source ;
    tss:embedded true ;
    tss:format tss:JSON ;
    tss:schema ex:zevenaarshaven-quality-color-schema ;
    tss:pointLayout tss:Object ;
    tss:points """[
        { "time": "2021-03-03T23:15:00Z", "value": "rgba(0, 128, 0, 1.0)"},
        { "time": "2021-03-03T23:30:00Z", "value": "rgba(0, 128, 0, 1.0)"},
        { "time": "2021-03-03T23:45:00Z", "value": "rgba(0, 128, 0, 1.0)"},
        { "time": "2021-03-04T00:30:00Z", "value": "rgba(0, 128, 0, 1.0)"},
        { "time": "2021-03-04T01:00:00Z", "value": "rgba(0, 128, 0, 1.0)"}
      ]"""^^rdf:JSON .

ex:zevenaarshaven-quality-color-schema
    a tss:Schema ;
    tss:hasField ex:zevenaarshaven-quality-color-time-field,
        ex:zevenaarshaven-quality-color-value-field .

ex:zevenaarshaven-quality-color-time-field
    a tss:Field ;
    tss:key "time" ;
    rdfs:label "Observation time"@en ;
    tss:datatype xsd:dateTime ;
    tss:required true .

ex:zevenaarshaven-quality-color-value-field
    a tss:Field ;
    tss:key "value" ;
    rdfs:label "Quality code colour of the EC20 values, Zevenaarshaven (NL)"@en ;
    tss:datatype xsd:string ;
    tss:observedProperty ex:qualityCodeColor ;
    tss:describesField ex:zevenaarshaven-ec20-value-field .

ex:snippet-zevenaarshaven-quality-code-color
    a tss:Snippet ;
    rdfs:label "Quality code colour of the EC20 values, Zevenaarshaven (NL)"@en ;
    tss:source ex:zevenaarshaven-quality-color-source ;
    tss:timeField ex:zevenaarshaven-quality-color-time-field ;
    tss:valueField ex:zevenaarshaven-quality-color-value-field ;
    tss:from "2021-03-03T23:15:00Z"^^xsd:dateTime ;
    tss:until "2026-01-01T00:00:00Z"^^xsd:dateTime ;
    tss:featureOfInterest ex:snippet-zevenaarshaven-ec20 .

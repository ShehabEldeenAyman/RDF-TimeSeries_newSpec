VERSION "1.2-messages"
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX tss: <https://w3id.org/tss#>
PREFIX ex: <https://example.org/ex#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX quantitykind: <http://qudt.org/vocab/quantitykind/>
PREFIX unit: <http://qudt.org/vocab/unit/>

# Demo 7: experimental RDF time-series schema with field-level source locators.
# The new TSS schema, field, source and locator terms are proposal vocabulary.
# Logical datatypes interpret CSV and embedded-point lexical values; native types stay in the file.
# Source windows are [from, until).
# tss:key is the time field: no two points have the same time.
# The fields state no tss:columnName: in RDF points, the IRI of a field is the predicate of its values.
# RDFS/catalog annotations and external datatype/unit identifiers are retained.

# A copy of waterinfo_289441042_tss2_points_embedded.ttl with one series only: each point
# holds just a time and a value (the EC20 reading); the quality code colour is left out.
# The source and its fields have their own IRIs (ex:zevenaarshaven-tv-...), so the two documents
# never describe the same node in two ways; the sensor, the feature of interest and the station
# are the same real-world things, so they keep their IRIs.

# A growing source: it does not state tss:immutable true, so points may still be added to it.
# Its metadata document is therefore an RDF Message Log (RDF Messages, version label
# "1.2-messages"): this first message describes the source and its fields, and each next message
# holds one point. Every message ends with the delimiter MESSAGE, so a consumer that follows the
# source knows the last message it read is complete.
# The source states tss:rangeRequests true: its publisher promises that the log only grows, byte
# for byte, so a consumer fetches only the new messages with an HTTP Range request
# (Range: bytes=N-). Without it, the publisher could write the log anew on every change, and a
# consumer would read the whole log again.
# While the source grows, its description does not change: a writer only appends messages.
# A growing source has no stored summaries. To end the source, a writer appends one last
# message with "ex:zevenaarshaven-tv-source tss:immutable true ." and, optionally, a
# tss:summary for each field.
# The log never states tss:immutable false: the merge of all messages would then state both.

# The log follows the RDF Message Stream Profile of the specification: a description message,
# then one point message per point (the timestamp is the point's value for the time field).
<> dcterms:conformsTo tss:MessageStreamProfile .

ex:zevenaarshaven-tv-source
    a tss:EmbeddedRDFSource ;
    rdfs:label "Waterinfo EC20, Kanaal Gent-Terneuzen Zevenaarshaven (NL), time and value points"@en ;
    # Optional tss:sourceDescription; publishers may use any RDF vocabulary and properties.
    tss:sourceDescription [
        dcterms:spatial [
            a dcterms:Location ;
            rdfs:label "Kanaal Gent-Terneuzen Zevenaarshaven (NL)"@en
        ]
    ] ;
    tss:producedBy ex:289441042 ;
    # The points' times are xsd:dateTime literals (a timezone is required), such as 2021-03-03T23:15:00Z.
    tss:timeField ex:zevenaarshaven-tv-time-field ;
    tss:key ex:zevenaarshaven-tv-time-field ;
    # The window of a growing source does not change, and every new point must lie in it, so the
    # window is left open at the end: the source states no tss:until.
    tss:from "2021-03-03T23:15:00Z"^^xsd:dateTime ;
    tss:rangeRequests true ;
    tss:hasField ex:zevenaarshaven-tv-time-field,
        ex:zevenaarshaven-tv-value-field .

ex:zevenaarshaven-tv-time-field
    a tss:Field ;
    rdfs:label "Observation time"@en ;
    tss:datatype xsd:dateTime ;
    tss:fieldDescription [
        dcterms:description "Observation time"@en
    ] .

ex:zevenaarshaven-tv-value-field
    a tss:Field ;
    rdfs:label "Electrical conductivity at 20 °C, Kanaal Gent-Terneuzen Zevenaarshaven (NL)"@en ;
    tss:datatype xsd:double ;
    tss:minimum "0"^^xsd:double ;
    # Example only: 10000 is a placeholder, not a real validated upper limit.
    tss:maximum "10000"^^xsd:double ;
    tss:observedProperty quantitykind:ElectricConductivity ;
    tss:unit unit:MicroS-PER-CentiM ;
    tss:sensor ex:sensor-zevenaarshaven-ec20 ;
    tss:featureOfInterest ex:water-zevenaarshaven ;
    tss:fieldDescription [
        dcterms:description "Electrical conductivity at 20 °C, Kanaal Gent-Terneuzen Zevenaarshaven (NL)"@en ;
        dcterms:subject quantitykind:ElectricConductivity ;
        dcterms:relation ex:sensor-zevenaarshaven-ec20, ex:water-zevenaarshaven
    ] .
MESSAGE
# Points: one message per point, appended at the end of the log; a Write appends one more.
# tss:hasPoint links the source to each point. Each value has its field's IRI as predicate
# and is typed with the field's tss:datatype; a missing value has no triple.
# The points are unordered (sort by the value of the tss:timeField).
ex:zevenaarshaven-tv-source tss:hasPoint [
    ex:zevenaarshaven-tv-time-field "2021-03-03T23:15:00Z"^^xsd:dateTime ;
    ex:zevenaarshaven-tv-value-field "4797.72"^^xsd:double
] .
MESSAGE
ex:zevenaarshaven-tv-source tss:hasPoint [
    ex:zevenaarshaven-tv-time-field "2021-03-03T23:30:00Z"^^xsd:dateTime ;
    ex:zevenaarshaven-tv-value-field "4717.8"^^xsd:double
] .
MESSAGE
ex:zevenaarshaven-tv-source tss:hasPoint [
    ex:zevenaarshaven-tv-time-field "2021-03-03T23:45:00Z"^^xsd:dateTime ;
    ex:zevenaarshaven-tv-value-field "4745.36"^^xsd:double
] .
MESSAGE
ex:zevenaarshaven-tv-source tss:hasPoint [
    ex:zevenaarshaven-tv-time-field "2021-03-04T00:30:00Z"^^xsd:dateTime ;
    ex:zevenaarshaven-tv-value-field "4716.1"^^xsd:double
] .
MESSAGE
ex:zevenaarshaven-tv-source tss:hasPoint [
    ex:zevenaarshaven-tv-time-field "2021-03-04T01:00:00Z"^^xsd:dateTime ;
    ex:zevenaarshaven-tv-value-field "4775.96"^^xsd:double
] .
MESSAGE

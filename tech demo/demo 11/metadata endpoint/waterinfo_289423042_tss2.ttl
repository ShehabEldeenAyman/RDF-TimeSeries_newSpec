    tss:describesField ex:grootdok-ec20-field ;
    tss:fieldDescription [
        dcterms:description "KiWIS interpolation type code of the value"@en ;
        dcterms:relation ex:grootdok-ec20-field
    ] ;
    tss:summary [
        tss:missingValuePolicy tss:ExcludeEmptyValues ;

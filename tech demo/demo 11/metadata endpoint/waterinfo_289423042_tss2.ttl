@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix tss: <https://w3id.org/tss#> .
@prefix ex: <https://example.org/ex#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix quantitykind: <http://qudt.org/vocab/quantitykind/> .
@prefix unit: <http://qudt.org/vocab/unit/> .

# Demo 7: experimental RDF time-series schema with field-level snippet locators.
# The new TSS schema, field, snippet and locator terms are proposal vocabulary.
# Logical datatypes interpret CSV and embedded-point lexical values; native types stay in the file.
# Snippet windows are [from, until).
# tss:key is the time field: no two rows have the same time.
# tss:columnIndex is optional when tss:columnName identifies a field; indices are zero-based.
# RDFS/catalog annotations and external datatype/unit identifiers are retained.

# Shared snippet: provenance, time window, time field and column schema.

ex:grootdok-snippet
    a tss:CSVSnippet ;
    rdfs:label "Waterinfo EC20, Kanaal Gent-Terneuzen Grootdok (BE)"@en ;
    # Optional tss:snippetDescription; publishers may use any RDF vocabulary and properties.
    tss:snippetDescription [
        dcterms:spatial [
            a dcterms:Location ;
            rdfs:label "Kanaal Gent-Terneuzen Grootdok (BE)"@en
        ]
    ] ;
    tss:mutable false ;
    tss:producedBy ex:station-grootdok ;
    tss:from "2021-03-03T23:45:00Z"^^xsd:dateTimeStamp ;
    tss:until "2025-12-18T23:15:00Z"^^xsd:dateTimeStamp ;
    # Committed until: the last time the snippet and its data were checked to be up to date.
    tss:committedUntil "2026-10-26T11:43:43Z"^^xsd:dateTimeStamp ;
    tss:dataFile <../data/waterinfo_289423042.csv> ;
    # The "Timestamp" column of the data file holds UTC times such as 2021-03-03T23:45:00Z:
    # xsd:dateTimeStamp texts (a timezone is required).
    tss:timeField ex:grootdok-time-field ;
    tss:key ex:grootdok-time-field ;
    tss:hasField ex:grootdok-ts_id-field,
        ex:grootdok-time-field,
        ex:grootdok-ec20-field,
        ex:grootdok-interpolation-type-field,
        ex:grootdok-quality-code-field,
        ex:grootdok-quality-code-name-field,
        ex:grootdok-quality-code-description-field,
        ex:grootdok-quality-code-color-field ;
    tss:delimiter "," ;
    tss:header true ;
    tss:encoding "utf-8" .

# Field definitions include measurement meaning, units, sensor and feature.
# Optional tss:fieldDescription records use Dublin Core here; any RDF vocabulary may be used.

# Generated column summaries (calculated from the actual data, not example values).
# Each summary covers the existing rows/points in the snippet's window [tss:from, tss:until);
# a summary has no window of its own.
# tss:ExcludeEmptyValues excludes nulls, absent keys and empty strings ("");
# whitespace-only strings are not treated as empty. tss:count counts present values;
# tss:missing counts empty values in existing rows, not absent timestamps or time gaps.
# tss:firstTime / tss:lastTime are the first/last timestamps with a present field value.
# Numeric aggregates are for conductivity fields, in their declared units if known.
# Mean is the unweighted arithmetic mean; median averages the middle two values for even counts.
# All present readings are included regardless of quality codes or the expected range.
# Observed extrema do not replace the expected tss:minimum / tss:maximum range.
# For embedded data these summaries describe only the supplied sample points.
# tss:generatedAtTime records calculation time; summaries are not refreshed automatically.

ex:grootdok-ts_id-field
    a tss:Field ;
    tss:columnName "ts_id" ;
    tss:columnIndex 0 ;
    rdfs:label "ts_id"@en ;
    tss:datatype xsd:integer ;
    rdfs:comment "waterinfo.be time series identifier (the same on every row)"@en ;
    tss:fieldDescription [
        dcterms:description "waterinfo.be time series identifier (the same on every row)"@en
    ] ;
    tss:summary [
        tss:missingValuePolicy tss:ExcludeEmptyValues ;
        tss:count "94853"^^xsd:integer ;
        tss:missing "0"^^xsd:integer ;
        tss:firstTime "2021-03-03T23:45:00+00:00"^^xsd:dateTimeStamp ;
        tss:lastTime "2025-12-18T23:00:00+00:00"^^xsd:dateTimeStamp ;
        tss:generatedAtTime "2026-10-22T14:02:30+00:00"^^xsd:dateTimeStamp
    ] .

ex:grootdok-time-field
    a tss:Field ;
    tss:columnName "Timestamp" ;
    tss:columnIndex 1 ;
    rdfs:label "Timestamp"@en ;
    tss:datatype xsd:dateTimeStamp ;
    rdfs:comment "Observation time (UTC)"@en ;
    tss:fieldDescription [
        dcterms:description "Observation time (UTC)"@en
    ] ;
    tss:summary [
        tss:missingValuePolicy tss:ExcludeEmptyValues ;
        tss:count "94853"^^xsd:integer ;
        tss:missing "0"^^xsd:integer ;
        tss:firstTime "2021-03-03T23:45:00+00:00"^^xsd:dateTimeStamp ;
        tss:lastTime "2025-12-18T23:00:00+00:00"^^xsd:dateTimeStamp ;
        tss:generatedAtTime "2026-10-22T14:02:30+00:00"^^xsd:dateTimeStamp
    ] .

ex:grootdok-ec20-field
    a tss:Field ;
    tss:columnName "Value" ;
    tss:columnIndex 2 ;
    rdfs:label "Electrical conductivity at 20 °C, Kanaal Gent-Terneuzen Grootdok (BE)"@en ;
    tss:datatype xsd:double ;
    rdfs:comment "Electrical conductivity at 20 °C"@en ;
    tss:minimum 0 ;
    # Example only: 10000 is a placeholder, not a real validated upper limit.
    tss:maximum "10000"^^xsd:double ;
    tss:observedProperty quantitykind:ElectricConductivity ;
    tss:unit unit:MicroS-PER-CentiM ;
    tss:sensor ex:sensor-grootdok-ec20 ;
    tss:featureOfInterest ex:water-grootdok ;
    tss:fieldDescription [
        dcterms:description "Electrical conductivity at 20 °C"@en ;
        dcterms:subject quantitykind:ElectricConductivity ;
        dcterms:relation ex:sensor-grootdok-ec20, ex:water-grootdok
    ] ;
    tss:summary [
        tss:missingValuePolicy tss:ExcludeEmptyValues ;
        tss:count "94853"^^xsd:integer ;
        tss:missing "0"^^xsd:integer ;
        tss:firstTime "2021-03-03T23:45:00+00:00"^^xsd:dateTimeStamp ;
        tss:lastTime "2025-12-18T23:00:00+00:00"^^xsd:dateTimeStamp ;
        tss:observedMinimum "125.57"^^xsd:double ;
        tss:observedMaximum "19035.51"^^xsd:double ;
        tss:mean "4429.554312357016"^^xsd:double ;
        tss:median "3375.36"^^xsd:double ;
        tss:generatedAtTime "2026-10-22T14:02:30+00:00"^^xsd:dateTimeStamp
    ] .


@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix tss: <https://w3id.org/tss#> .
@prefix ex: <https://example.org/ex#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix quantitykind: <http://qudt.org/vocab/quantitykind/> .
@prefix unit: <http://qudt.org/vocab/unit/> .

# Demo 7: experimental RDF time-series schema with field-level snippet locators.
# The new TSS schema, field, snippet and locator terms are proposal vocabulary.
# Logical datatypes interpret CSV and embedded-point lexical values; native types stay in the file.
# Snippet windows are [from, until).
# tss:key is the time field: no two points have the same time.
# The fields state no tss:columnName: in RDF points, the IRI of a field is the predicate of its values.
# RDFS/catalog annotations and external datatype/unit identifiers are retained.

# One embedded snippet contains both series, with one shared time field.
# The snippet window applies to all fields; the points are five-reading samples.
# The points are RDF at the end of this document (see "Points" below).

ex:zevenaarshaven-snippet
    a tss:EmbeddedRDFMessagesSnippet ;
    rdfs:label "Waterinfo EC20, Kanaal Gent-Terneuzen Zevenaarshaven (NL)"@en ;
    # Optional tss:snippetDescription; publishers may use any RDF vocabulary and properties.
    tss:snippetDescription [
        dcterms:spatial [
            a dcterms:Location ;
            rdfs:label "Kanaal Gent-Terneuzen Zevenaarshaven (NL)"@en
        ]
    ] ;
    tss:mutable false ;
    tss:producedBy ex:289441042 ;
    # The points' times are xsd:dateTimeStamp literals (a timezone is required), such as 2021-03-03T23:15:00Z.
    tss:timeField ex:zevenaarshaven-time-field ;
    tss:key ex:zevenaarshaven-time-field ;
    tss:from "2021-03-03T23:15:00Z"^^xsd:dateTimeStamp ;
    tss:until "2026-01-01T00:00:00Z"^^xsd:dateTimeStamp ;
    # Committed until: the last time the snippet and its data were checked to be up to date.
    tss:committedUntil "2026-10-26T11:43:43Z"^^xsd:dateTimeStamp ;
    tss:hasField ex:zevenaarshaven-time-field,
        ex:zevenaarshaven-ec20-value-field,
        ex:zevenaarshaven-quality-color-value-field .

# Generated field summaries (calculated from the actual data, not example values).
# Each summary covers the existing rows/points in the snippet's window [tss:from, tss:until);
# a summary has no window of its own.
# tss:ExcludeEmptyValues excludes nulls, absent keys and empty strings ("");
# whitespace-only strings are not treated as empty. tss:count counts present values;
# tss:missing counts empty values in existing rows, not absent timestamps or time gaps.
# tss:firstTime / tss:lastTime are the first/last timestamps with a present field value.
# Numeric aggregates are for conductivity fields, in their declared units if known.
# Mean is the unweighted arithmetic mean; median averages the middle two values for even counts.
# All present readings are included regardless of quality codes or the expected range.
# Observed extrema do not replace the expected tss:minimum / tss:maximum range.
# For embedded data these summaries describe only the supplied sample points.
# tss:generatedAtTime records calculation time; summaries are not refreshed automatically.

ex:zevenaarshaven-time-field
    a tss:Field ;
    rdfs:label "Observation time"@en ;
    tss:datatype xsd:dateTimeStamp ;
    tss:fieldDescription [
        dcterms:description "Observation time"@en
    ] ;
    tss:summary [
        tss:missingValuePolicy tss:ExcludeEmptyValues ;
        tss:count "5"^^xsd:integer ;
        tss:missing "0"^^xsd:integer ;
        tss:firstTime "2021-03-03T23:15:00+00:00"^^xsd:dateTimeStamp ;
        tss:lastTime "2021-03-04T01:00:00+00:00"^^xsd:dateTimeStamp ;
        tss:generatedAtTime "2026-10-22T14:02:30+00:00"^^xsd:dateTimeStamp
    ] .

ex:zevenaarshaven-ec20-value-field
    a tss:Field ;
    rdfs:label "Electrical conductivity at 20 °C, Kanaal Gent-Terneuzen Zevenaarshaven (NL)"@en ;
    tss:datatype xsd:double ;
    tss:minimum "0"^^xsd:double ;
    # Example only: 10000 is a placeholder, not a real validated upper limit.
    tss:maximum "10000"^^xsd:double ;
    tss:observedProperty quantitykind:ElectricConductivity ;
    tss:unit unit:MicroS-PER-CentiM ;
    tss:sensor ex:sensor-zevenaarshaven-ec20 ;
    tss:featureOfInterest ex:water-zevenaarshaven ;
    tss:fieldDescription [
        dcterms:description "Electrical conductivity at 20 °C, Kanaal Gent-Terneuzen Zevenaarshaven (NL)"@en ;
        dcterms:subject quantitykind:ElectricConductivity ;
        dcterms:relation ex:sensor-zevenaarshaven-ec20, ex:water-zevenaarshaven
    ] ;
    tss:summary [
        tss:missingValuePolicy tss:ExcludeEmptyValues ;
        tss:count "5"^^xsd:integer ;
        tss:missing "0"^^xsd:integer ;
        tss:firstTime "2021-03-03T23:15:00+00:00"^^xsd:dateTimeStamp ;
        tss:lastTime "2021-03-04T01:00:00+00:00"^^xsd:dateTimeStamp ;
        tss:observedMinimum "4716.1"^^xsd:double ;
        tss:observedMaximum "4797.72"^^xsd:double ;
        tss:mean "4750.588"^^xsd:double ;
        tss:median "4745.36"^^xsd:double ;
        tss:generatedAtTime "2026-10-22T14:02:30+00:00"^^xsd:dateTimeStamp
    ] .

ex:zevenaarshaven-quality-color-value-field
    a tss:Field ;
    rdfs:label "Quality code colour of the EC20 values, Zevenaarshaven (NL)"@en ;
    tss:datatype xsd:string ;
    tss:observedProperty ex:qualityCodeColor ;
    tss:describesField ex:zevenaarshaven-ec20-value-field ;
    tss:fieldDescription [
        dcterms:description "Quality code colour of the EC20 values, Zevenaarshaven (NL)"@en ;
        dcterms:subject ex:qualityCodeColor ;
        dcterms:relation ex:zevenaarshaven-ec20-value-field
    ] ;
    tss:summary [
        tss:missingValuePolicy tss:ExcludeEmptyValues ;
        tss:count "5"^^xsd:integer ;
        tss:missing "0"^^xsd:integer ;
        tss:firstTime "2021-03-03T23:15:00+00:00"^^xsd:dateTimeStamp ;
        tss:lastTime "2021-03-04T01:00:00+00:00"^^xsd:dateTimeStamp ;
        tss:generatedAtTime "2026-10-22T14:02:30+00:00"^^xsd:dateTimeStamp
    ] .

# Points: one RDF node per point, at the end of the document, so that a new point of a
# mutable snippet is appended as one more Turtle statement without touching the rest.
# tss:hasPoint links the snippet to each point. Each value has its field's IRI as predicate
# and is typed with the field's tss:datatype; a missing value has no triple.
# The points are unordered (sort by the value of the tss:timeField).

ex:zevenaarshaven-snippet tss:hasPoint [
    ex:zevenaarshaven-time-field "2021-03-03T23:15:00Z"^^xsd:dateTimeStamp ;
    ex:zevenaarshaven-ec20-value-field "4797.72"^^xsd:double ;
    ex:zevenaarshaven-quality-color-value-field "rgba(0, 128, 0, 1.0)"^^xsd:string
] .

ex:zevenaarshaven-snippet tss:hasPoint [
    ex:zevenaarshaven-time-field "2021-03-03T23:30:00Z"^^xsd:dateTimeStamp ;
    ex:zevenaarshaven-ec20-value-field "4717.8"^^xsd:double ;
    ex:zevenaarshaven-quality-color-value-field "rgba(0, 128, 0, 1.0)"^^xsd:string
] .

ex:zevenaarshaven-snippet tss:hasPoint [
    ex:zevenaarshaven-time-field "2021-03-03T23:45:00Z"^^xsd:dateTimeStamp ;
    ex:zevenaarshaven-ec20-value-field "4745.36"^^xsd:double ;
    ex:zevenaarshaven-quality-color-value-field "rgba(0, 128, 0, 1.0)"^^xsd:string
] .

ex:zevenaarshaven-snippet tss:hasPoint [
    ex:zevenaarshaven-time-field "2021-03-04T00:30:00Z"^^xsd:dateTimeStamp ;
    ex:zevenaarshaven-ec20-value-field "4716.1"^^xsd:double ;
    ex:zevenaarshaven-quality-color-value-field "rgba(0, 128, 0, 1.0)"^^xsd:string
] .

ex:zevenaarshaven-snippet tss:hasPoint [
    ex:zevenaarshaven-time-field "2021-03-04T01:00:00Z"^^xsd:dateTimeStamp ;
    ex:zevenaarshaven-ec20-value-field "4775.96"^^xsd:double ;
    ex:zevenaarshaven-quality-color-value-field "rgba(0, 128, 0, 1.0)"^^xsd:string
] .

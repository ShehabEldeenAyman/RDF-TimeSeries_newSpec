@prefix tss: <https://w3id.org/tss#> .
@prefix ex: <https://example.org/rdftss-cq/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix unit: <http://qudt.org/vocab/unit/> .

# Synthetic metadata, not Waterinfo observations. example.org files are placeholders.
# Each named graph stands for a separate publication document.
# No source files are supplied or fetched; embedded series are empty.

ex:csvDocument {
ex:csvSnippet
    a tss:CSVSnippet ;
    tss:immutable true ;
    tss:timeField ex:csvTime ;
    tss:hasField ex:csvTime, ex:csvValue ;
    tss:from "2026-01-01T00:00:00Z"^^xsd:dateTimeStamp ;
    tss:until "2026-01-02T00:00:00Z"^^xsd:dateTimeStamp ;
    tss:dataFile <https://example.org/rdftss-cq/data/csv.csv> .
ex:csvTime a tss:Field ; tss:datatype xsd:dateTimeStamp ; tss:columnName "timestamp" .
ex:csvValue a tss:Field ;
    tss:datatype xsd:double ;
    tss:observedProperty ex:ElectricalConductivity ;
    tss:featureOfInterest ex:WaterBodyA ;
    tss:sensor ex:sensorA ;
    tss:unit unit:MicroS-PER-CentiM ;
    tss:columnName "value" ;
    tss:summary ex:csvSummary .
ex:csvSummary tss:count 3 ; tss:missing 0 ;
    tss:missingValuePolicy tss:ExcludeEmptyValues ;
    tss:observedMinimum "4722.4"^^xsd:double ;
    tss:observedMaximum "4810.5"^^xsd:double ;
    tss:generatedAtTime "2026-01-02T10:00:00Z"^^xsd:dateTimeStamp .
}

ex:parquetDocument {
ex:parquetSnippet
    a tss:ParquetSnippet ;
    tss:immutable true ;
    tss:timeField ex:parquetTime ;
    tss:hasField ex:parquetTime, ex:parquetValue ;
    tss:from "2025-12-01T00:00:00Z"^^xsd:dateTimeStamp ;
    tss:dataFile <https://example.org/rdftss-cq/data/parquet.parquet> .
ex:parquetTime a tss:Field ; tss:datatype xsd:dateTimeStamp ; tss:columnName "recorded_at" .
ex:parquetValue a tss:Field ;
    tss:datatype xsd:double ;
    tss:observedProperty ex:ElectricalConductivity ;
    tss:featureOfInterest ex:WaterBodyA ;
    tss:sensor ex:sensorA ;
    tss:unit unit:MicroS-PER-CentiM ;
    tss:columnName "conductivity" .
}

ex:arrowDocument {
ex:arrowSnippet
    a tss:ArrowSnippet ;
    # Growing: it does not state tss:immutable true, so record batches may still be appended
    # to its data file, an Arrow IPC stream.
    tss:timeField ex:arrowTime ;
    tss:hasField ex:arrowTime, ex:arrowValue ;
    tss:from "2026-01-01T00:00:00Z"^^xsd:dateTimeStamp ;
    tss:until "2026-01-02T00:00:00Z"^^xsd:dateTimeStamp ;
    tss:dataFile <https://example.org/rdftss-cq/data/arrow.arrows> .
ex:arrowTime a tss:Field ; tss:datatype xsd:dateTimeStamp ; tss:columnName "timestamp" .
ex:arrowValue a tss:Field ;
    tss:datatype xsd:double ;
    tss:observedProperty ex:ElectricalConductivity ;
    tss:featureOfInterest ex:WaterBodyA ;
    tss:sensor ex:sensorA ;
    tss:unit unit:MicroS-PER-CentiM ;
    tss:columnName "value" .
}

ex:gridDocument {
ex:gridSnippet
    a tss:CSVSnippet ;
    tss:immutable true ;
    tss:timeField ex:gridTime ;
    tss:hasField ex:gridTime, ex:gridValue, ex:gridStep ;
    tss:from "2026-01-01T00:00:00Z"^^xsd:dateTimeStamp ;
    tss:until "2026-01-02T00:00:00Z"^^xsd:dateTimeStamp ;
    tss:dataFile <https://example.org/rdftss-cq/data/grid.csv> ;
    tss:timeBase "2026-01-01T08:00:00Z"^^xsd:dateTimeStamp ;
    tss:timeStep "PT15M"^^xsd:duration ;
    tss:stepField ex:gridStep .
ex:gridTime a tss:Field ; tss:datatype xsd:dateTimeStamp .
ex:gridValue a tss:Field ;
    tss:datatype xsd:double ;
    tss:observedProperty ex:ElectricalConductivity ;
    tss:featureOfInterest ex:WaterBodyA ;
    tss:sensor ex:sensorA ;
    tss:unit unit:MicroS-PER-CentiM ;
    tss:columnName "value" .
ex:gridStep a tss:Field ; tss:columnName "step" ; tss:datatype xsd:integer .
}

ex:deltaDocument {
ex:deltaSnippet
    a tss:CSVSnippet ;
    tss:immutable true ;
    tss:timeField ex:deltaTime ;
    tss:hasField ex:deltaTime, ex:deltaValue ;
    tss:from "2026-01-01T00:00:00Z"^^xsd:dateTimeStamp ;
    tss:until "2026-01-02T00:00:00Z"^^xsd:dateTimeStamp ;
    tss:dataFile <https://example.org/rdftss-cq/data/delta.csv> .
ex:deltaTime a tss:Field ; tss:datatype xsd:dateTimeStamp ; tss:columnName "timestamp" .
ex:deltaValue a tss:Field ;
    tss:datatype xsd:double ;
    tss:observedProperty ex:ElectricalConductivity ;
    tss:featureOfInterest ex:WaterBodyA ;
    tss:sensor ex:sensorA ;
    tss:unit unit:MicroS-PER-CentiM ;
    tss:columnName "value" ;
    tss:valueEncoding tss:DeltaFromBaseline ;
    tss:baseline "4750"^^xsd:double .
}


_:ne38b1b46294a4f0f9a4c12eff0676039b160 a sh:SPARQLConstraint ;
    sh:message "S26 summary of a growing source: field {?value} has a tss:summary, but the source does not state tss:immutable true. Only a field of an immutable source has a stored summary." ;
    sh:prefixes <https://w3id.org/tss/shapes/external> ;
    sh:select """
            SELECT $this ?value WHERE {
                $this tss:hasField ?value .
                ?value tss:summary ?summary .
                FILTER NOT EXISTS { $this tss:immutable ?immutable . FILTER (?immutable = true) }
            }""" .


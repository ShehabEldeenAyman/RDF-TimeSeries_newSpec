@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://example.org/ex#grootdok-source> ;
            sh:resultMessage "S23 timezone: 2021-03-03T23:45:00 (the source's tss:from) has no timezone. Every time MUST have a timezone, such as Z or +02:00, also as an xsd:dateTime." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "S23 timezone: {?value} ({?where}) has no timezone. Every time MUST have a timezone, such as Z or +02:00, also as an xsd:dateTime." ;
                    sh:prefixes <https://w3id.org/tss/shapes/external> ;
                    sh:select """
            SELECT DISTINCT $this ?value ?where WHERE {
                {
                    # A time of the source
                    $this ?property ?value .
                    FILTER (?property IN (tss:from, tss:until, tss:timeBase))
                    BIND (CONCAT("the source's ", REPLACE(STR(?property), "^.*#", "tss:")) AS ?where)
                } UNION {
                    # A time of a summary
                    $this tss:hasField ?field .
                    ?field tss:summary ?summary .
                    ?summary ?property ?value .
                    FILTER (?property IN (tss:firstTime, tss:lastTime, tss:generatedAtTime))
                    BIND (CONCAT("a summary's ", REPLACE(STR(?property), "^.*#", "tss:")) AS ?where)
                }
                FILTER (isLiteral(?value) && STR(?value) != "" && !REGEX(STR(?value), "(Z|[+-][0-9]{2}:[0-9]{2})$"))
            }""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <https://w3id.org/tss/shapes/external#TimezoneShape> ;
            sh:value "2021-03-03T23:45:00"^^xsd:dateTime ] .


@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://example.org/ex#zevenaarshaven-source> ;
            sh:resultMessage "P2 time window: the point at 2026-02-01T00:00:00Z is not before tss:until (until is not included)." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "P2 time window: the point at {?value} is not before tss:until (until is not included)." ;
                    sh:prefixes <https://w3id.org/tss/shapes/embedded> ;
                    sh:select """
            SELECT $this ?value WHERE {
                $this tss:until ?until ; tss:hasPoint ?point .
                ?point tss:time ?value .
                BIND (xsd:dateTime(IF(REGEX(STR(?value), "(Z|[+-][0-9]{2}:[0-9]{2})$"), STR(?value), CONCAT(STR(?value), "Z"))) AS ?moment)
                BIND (xsd:dateTime(IF(REGEX(STR(?until), "(Z|[+-][0-9]{2}:[0-9]{2})$"), STR(?until), CONCAT(STR(?until), "Z"))) AS ?bound)
                FILTER (BOUND(?moment) && BOUND(?bound) && ?moment >= ?bound)
            }""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <https://w3id.org/tss/shapes/embedded#PointsShape> ;
            sh:value "2026-02-01T00:00:00Z"^^xsd:dateTime ] .


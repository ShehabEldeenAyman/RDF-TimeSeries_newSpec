[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode ns2:zevenaarshaven-source ;
            sh:resultMessage "P8 field: a point states tss:field https://example.org/ex#zevenaarshaven-quality-color-value-field, which is not a value field (tss:ValueField) of its source." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "P8 field: a point states tss:field {?field}, which is not a value field (tss:ValueField) of its source." ;
                    sh:prefixes <https://w3id.org/tss/shapes/embedded> ;
                    sh:select """
            SELECT DISTINCT $this ?value ?field WHERE {
                $this tss:hasPoint ?value .
                ?value tss:field ?field .
                FILTER NOT EXISTS { $this tss:hasField ?field . ?field a tss:ValueField }
            }""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <https://w3id.org/tss/shapes/embedded#PointsShape> ;

@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://example.org/ex#zevenaarshaven-vd-value-field> ;
            sh:resultMessage "D1 value encoding: the field's values are differences (tss:DeltaFromBaseline), but it has no tss:baseline to add them to." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "D1 value encoding: the field's values are differences (tss:DeltaFromBaseline), but it has no tss:baseline to add them to." ;
                    sh:prefixes <https://w3id.org/tss/shapes/external> ;
                    sh:select """
            SELECT $this WHERE {
                $this tss:valueEncoding tss:DeltaFromBaseline .
                FILTER NOT EXISTS { $this tss:baseline ?baseline }
            }""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <https://w3id.org/tss/shapes/external#FieldShape> ;
            sh:value <https://example.org/ex#zevenaarshaven-vd-value-field> ] .


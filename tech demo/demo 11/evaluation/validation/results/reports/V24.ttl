            sh:value 4.74536e+03 ] .

_:n9b1c220b8b7647f29d512a387b76d0b8b99 a sh:SPARQLConstraint ;
    sh:message "P4 datatype: the point at {?when} has a value for this field that is not a literal with the field's tss:datatype." ;
    sh:prefixes <https://w3id.org/tss/shapes/embedded> ;
    sh:select """
            SELECT $this ?value ?when WHERE {
                ?source tss:hasField $this .
                $this tss:datatype ?datatype .
                { ?source tss:timeField $this ; tss:hasPoint ?point . ?point tss:time ?value . }
                UNION { $this a tss:ValueField . ?source tss:hasPoint ?point . ?point tss:value ?value . { ?point tss:field $this } UNION { FILTER NOT EXISTS { ?point tss:field ?anyField1 } ?source tss:hasField $this . $this a tss:ValueField . FILTER NOT EXISTS { ?source tss:hasField ?otherField1 . ?otherField1 a tss:ValueField . FILTER (?otherField1 != $this) } } }
                UNION { $this tss:property ?property . ?source tss:hasPoint ?point . ?point ?property ?value . }
                OPTIONAL { ?point tss:time ?time }
                BIND (COALESCE(STR(?time), "(no time)") AS ?when)
                FILTER (!isLiteral(?value) || (STR(?value) != "" && DATATYPE(?value) != ?datatype))
            }""" .


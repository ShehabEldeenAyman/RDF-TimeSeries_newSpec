    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://example.org/ex#zevenaarshaven-quality-color-value-field> ;
            sh:resultMessage "P4 datatype: the point at 2021-03-03T23:15:00Z has a value for this field that is not a literal with the field's tss:datatype." ;

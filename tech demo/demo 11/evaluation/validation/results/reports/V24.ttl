            sh:resultMessage "P4 datatype: the point at 2021-03-04T01:00:00Z has a value for this field that is not a literal with the field's tss:datatype." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint _:n9b1c220b8b7647f29d512a387b76d0b8b99 ;

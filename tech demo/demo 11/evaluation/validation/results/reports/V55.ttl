@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms true ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://example.org/ex#zevenaarshaven-source> ;
            sh:resultMessage "P6 properties: a point has the property https://example.org/ex#typo, which is not tss:field, tss:time, tss:value or the property of a describing field of the source, so its values are not read." ;
            sh:resultSeverity sh:Warning ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "P6 properties: a point has the property {?value}, which is not tss:field, tss:time, tss:value or the property of a describing field of the source, so its values are not read." ;
                    sh:prefixes <https://w3id.org/tss/shapes/embedded> ;
                    sh:select """
            SELECT DISTINCT $this ?value WHERE {
                $this tss:hasPoint ?point .
                ?point ?value ?any .
                FILTER (?value NOT IN (tss:field, tss:time, tss:value))
                FILTER NOT EXISTS { $this tss:hasField ?describing . ?describing tss:property ?value }
                # The default property of a describing field: the document IRI, '#', its column name
                FILTER NOT EXISTS {
                    $this tss:hasField ?default .
                    ?default tss:describesField ?described ; tss:columnName ?name .
                    FILTER NOT EXISTS { ?default tss:property ?property }
                    FILTER (STRENDS(STR(?value), CONCAT("#", ENCODE_FOR_URI(?name))))
                }
            }""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <https://w3id.org/tss/shapes/embedded#PointPropertiesShape> ;
            sh:value <https://example.org/ex#typo> ] .


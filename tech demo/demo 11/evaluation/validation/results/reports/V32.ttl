@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://example.org/ex#grootdok-ec20-field> ;
            sh:resultMessage "D3 baseline: the field has a tss:baseline (4750), but its tss:valueEncoding is not tss:DeltaFromBaseline." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "D3 baseline: the field has a tss:baseline ({?value}), but its tss:valueEncoding is not tss:DeltaFromBaseline." ;
                    sh:prefixes <https://w3id.org/tss/shapes/external> ;
                    sh:select """
            SELECT $this ?value WHERE {
                $this tss:baseline ?value .
                FILTER NOT EXISTS { $this tss:valueEncoding tss:DeltaFromBaseline }
            }""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <https://w3id.org/tss/shapes/external#FieldShape> ;
            sh:value 4.75e+03 ] .


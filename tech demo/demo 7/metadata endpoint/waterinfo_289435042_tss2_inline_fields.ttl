@prefix tss: <https://w3id.org/tss#> .
@prefix ex: <https://example.org/ex#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix quantitykind: <http://qudt.org/vocab/quantitykind/> .
@prefix unit: <http://qudt.org/vocab/unit/> .

# Demo 6: experimental RDF time-series schema with field-level source locators.
# The new TSS schema, field, source and locator terms are proposal vocabulary.
# Logical datatypes interpret CSV/JSON lexical values; native types stay in the file.
# Source windows are [from, until).
# Comparison copy: fields are anonymous nodes defined inline under tss:hasField.
# tss:timeField and tss:key reference the unique tss:columnName of a field.
# tss:describesField also references a field by its unique tss:columnName.
# This column-name reference convention differs from the original file's field-IRI references.
# tss:key identifies the column whose values uniquely identify a row.
# tss:columnIndex is optional when tss:columnName identifies a field; indices are zero-based.
# RDFS/catalog annotations and external datatype/unit identifiers are retained.

# Shared source: provenance, time window, time field and column schema.

ex:autrichehaven-source
    a tss:Source ;
    rdfs:label "Waterinfo EC20, Kanaal Gent-Terneuzen Autrichehaven (NL)"@en ;
    tss:mutable false ;
    tss:producedBy ex:station-autrichehaven ;
    tss:from "2021-03-03T23:15:00Z"^^xsd:dateTime ;
    tss:until "2025-10-07T07:45:00Z"^^xsd:dateTime ;
    tss:embedded false ;
    tss:dataFile <../data/waterinfo_289435042.csv> ;
    tss:format tss:CSV ;
    tss:timeField "Timestamp" ;
    tss:key "Timestamp" ;
    tss:hasField [
        a tss:Field ;
        tss:columnName "ts_id" ;
        tss:columnIndex 0 ;
        rdfs:label "ts_id"@en ;
        tss:datatype xsd:integer ;
        rdfs:comment "waterinfo.be time series identifier (the same on every row)"@en ;
        tss:required true
    ], [
        a tss:Field ;
        tss:columnName "Timestamp" ;
        tss:columnIndex 1 ;
        rdfs:label "Timestamp"@en ;
        tss:datatype xsd:dateTime ;
        rdfs:comment "Observation time (UTC)"@en ;
        tss:required true
    ], [
        a tss:Field ;
        tss:columnName "Value" ;
        tss:columnIndex 2 ;
        rdfs:label "Electrical conductivity at 20 °C, Kanaal Gent-Terneuzen Autrichehaven (NL)"@en ;
        tss:datatype xsd:double ;
        rdfs:comment "Electrical conductivity at 20 °C"@en ;
        tss:required true ;
        tss:minimum 0 ;
        # Example only: 10000 is a placeholder, not a real validated upper limit.
        tss:maximum "10000"^^xsd:double ;
        tss:observedProperty quantitykind:ElectricConductivity ;
        tss:unit unit:MicroS-PER-CentiM ;
        tss:sensor ex:sensor-autrichehaven-ec20 ;
        tss:featureOfInterest ex:water-autrichehaven
    ], [
        a tss:Field ;
        tss:columnName "Interpolation Type" ;
        tss:columnIndex 3 ;
        rdfs:label "Interpolation Type"@en ;
        tss:datatype xsd:integer ;
        rdfs:comment "KiWIS interpolation type code of the value"@en ;
        tss:describesField "Value"
    ], [
        a tss:Field ;
        tss:columnName "Quality Code" ;
        tss:columnIndex 4 ;
        rdfs:label "Quality Code"@en ;
        tss:datatype xsd:integer ;
        rdfs:comment "KiWIS quality code of the value"@en ;
        tss:describesField "Value"
    ], [
        a tss:Field ;
        tss:columnName "Quality Code Name" ;
        tss:columnIndex 5 ;
        rdfs:label "Quality Code Name"@en ;
        tss:datatype xsd:string ;
        rdfs:comment "Short name of the quality code"@en ;
        tss:describesField "Value"
    ], [
        a tss:Field ;
        tss:columnName "Quality Code Description" ;
        tss:columnIndex 6 ;
        rdfs:label "Quality Code Description"@en ;
        tss:datatype xsd:string ;
        rdfs:comment "Description of the quality code"@en ;
        tss:describesField "Value"
    ], [
        a tss:Field ;
        tss:columnName "Quality Code Color" ;
        tss:columnIndex 7 ;
        rdfs:label "Quality Code Color"@en ;
        tss:datatype xsd:string ;
        rdfs:comment "Display colour of the quality code (RGBA)"@en ;
        tss:observedProperty ex:qualityCodeColor ;
        tss:describesField "Value"
    ] ;
    tss:delimiter "," ;
    tss:header true ;
    tss:encoding "utf-8" .

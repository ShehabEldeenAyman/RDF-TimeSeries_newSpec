# Last edit of this metadata document, separate from data and summary timestamps.
<> tss:modifiedAt "2026-10-23T10:22:39Z"^^xsd:dateTime .

# Demo 7: experimental RDF time-series schema with field-level source locators.
# The new TSS schema, field, source and locator terms are proposal vocabulary.
# Logical datatypes interpret CSV and embedded-point lexical values; native types stay in the file.
# Source windows are [from, until).
# tss:key identifies the field whose values uniquely identify a row.
# tss:columnIndex is optional when tss:columnName identifies a field; indices are zero-based.
# RDFS/catalog annotations and external datatype/unit identifiers are retained.

# Shared source: provenance, time window, time field and column schema.

ex:factory-source
    a tss:Source ;
    rdfs:label "Factory water conductivity, 2025"@en ;
    # Optional tss:source_description; publishers may use any RDF vocabulary and properties.
    tss:source_description [
        dcterms:spatial [
            a s4inma:Factory ;
            # Illustrative site description: the factory name and coordinates were not supplied.
            rdfs:label "Factory site"@en
        ]
    ] ;
    tss:mutable false ;
    tss:producedBy ex:system1 ;
    tss:from "2025-01-01T00:00:00Z"^^xsd:dateTime ;
    tss:until "2026-01-01T00:00:00Z"^^xsd:dateTime ;
    tss:embedded false ;
    tss:dataFile <../data/factory_conductivity.csv> ;
    tss:format tss:CSV ;
    tss:timeField ex:factory-time-field ;
    tss:key ex:factory-time-field ;
    tss:hasField ex:factory-time-field,
        ex:factory-ro1_a_permeate_conductivity-field,
        ex:factory-ro1_b_permeate_conductivity-field,
        ex:factory-ro1_c_permeate_conductivity-field,
        ex:factory-ro2_a_permeate_conductivity-field,
        ex:factory-ro2_b_permeate_conductivity-field,
        ex:factory-cooling_water_conductivity-field,
        ex:factory-boiler_feed_conductivity-field,
        ex:factory-boiler_water_delivery_conductivity-field,
        ex:factory-dockwater_blowdown_conductivity-field,
        ex:factory-venturi_reject_conductivity-field,
        ex:factory-ro1de_feed_conductivity-field,
        ex:factory-ro1d_feed_conductivity-field,
        ex:factory-ro1e_feed_conductivity-field ;
    tss:delimiter ";" ;
    tss:header true ;
    tss:encoding "utf-8" .

# Field definitions include measurement meaning, units, sensor and feature.
# Optional tss:field_description records use Dublin Core here; any RDF vocabulary may be used.

# Generated column summaries (calculated from the actual data, not example values).
# Each summary covers existing rows/points in [tss:from, tss:until) only.
# tss:ExcludeEmptyValues excludes nulls, absent keys and empty strings ("");
# whitespace-only strings are not treated as empty. tss:count counts present values;
# tss:missing counts empty values in existing rows, not absent timestamps or time gaps.
# tss:firstTime / tss:lastTime are the first/last timestamps with a present field value.
# Numeric aggregates are for conductivity fields, in their declared units if known.
# Mean is the unweighted arithmetic mean; median averages the middle two values for even counts.
# All present readings are included regardless of quality codes or allowed bounds.
# Observed extrema do not replace the allowed tss:minimum / tss:maximum bounds.
# For embedded data these summaries describe only the supplied sample points.
# prov:generatedAtTime records calculation time; summaries are not refreshed automatically.

ex:factory-time-field
    a tss:Field ;
    tss:columnName "datetime" ;
    tss:columnIndex 0 ;
    rdfs:label "datetime"@en ;
    tss:datatype xsd:dateTime ;
    rdfs:comment "Observation time (UTC), 15-minute resolution"@en ;
    tss:field_description [
        dcterms:description "Observation time (UTC), 15-minute resolution"@en
    ] ;
    tss:summary [
        tss:from "2025-01-01T00:00:00+00:00"^^xsd:dateTime ;
        tss:until "2026-01-01T00:00:00+00:00"^^xsd:dateTime ;
        tss:missingValuePolicy tss:ExcludeEmptyValues ;
        tss:count "35033"^^xsd:integer ;
        tss:missing "0"^^xsd:integer ;
        tss:firstTime "2025-01-01T00:00:00+00:00"^^xsd:dateTime ;
        tss:lastTime "2025-12-31T23:45:00+00:00"^^xsd:dateTime ;
        prov:generatedAtTime "2026-10-22T14:02:30+00:00"^^xsd:dateTime
    ] .


@prefix quantitykind: <http://qudt.org/vocab/quantitykind/> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix tss: <https://w3id.org/tss#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix TSS2: <https://example.org/tss2#> .
@prefix ex: <https://example.org/ex#> .
@prefix ldes: <https://w3id.org/ldes#> .
@prefix csvw: <http://www.w3.org/ns/csvw#> .
@prefix wdrs: <http://www.w3.org/2007/05/powder-s#> .
# ADDED: two new prefixes for the live-channel additions (both real W3C WoT vocabularies, reused as-is)
@prefix td: <https://www.w3.org/2019/wot/td#> .
@prefix hctl: <https://www.w3.org/2019/wot/hypermedia#> .

# The physical table: one CSV file holding several time series. How to parse it
# (dialect, columns, datatypes) is described in its CSVW metadata; the properties
# below apply to every snippet that reads from this table.
ex:factory-conductivity-table a csvw:Table ;
    csvw:url <../data/factory_conductivity.csv> ;
    wdrs:describedby <../data/factory_conductivity.csv-metadata.json> ; # same relation CSVW uses for rel="describedby" discovery
    TSS2:mutable false ;
    TSS2:committedUntil "2025-12-31T23:45:00Z"^^xsd:dateTime ;
    TSS2:producedBy ex:system1 ;
    TSS2:startingFrom "2025-01-01T00:00:00Z"^^xsd:dateTime .

# One snippet per time series, i.e. per value column of the table. Expanding a
# snippet (as in TSS v1, section 3.2) turns each non-empty cell of valueColumn
# into a resource of tss:pointType, with the timeColumn value on tss:timePath,
# the cell value on tss:valuePath (datatypes from the CSVW metadata), plus the
# triples of the tss:about template. Sensors (ex:sensor-*) are described in the
# domain knowledge graph.

ex:snippet-ro1_a_permeate_conductivity-2025 a TSS2:Snippet ;
    rdfs:label "RO1 train A permeate conductivity, 2025"@en ;
    TSS2:table ex:factory-conductivity-table ;
    TSS2:timeColumn "datetime" ;
    TSS2:valueColumn "ro1_a_permeate_conductivity" ;
    tss:from "2025-01-01T00:00:00Z"^^xsd:dateTime ;
    tss:until "2026-01-01T00:00:00Z"^^xsd:dateTime ;
    tss:pointType sosa:Observation ;
    tss:timePath sosa:resultTime ;
    tss:valuePath sosa:hasSimpleResult ;
    tss:about [ a tss:PointTemplate ;
        sosa:madeBySensor ex:sensor-ro1_a_permeate ;
        sosa:observedProperty quantitykind:ElectricConductivity ] ;
    qudt:hasUnit unit:MicroS-PER-CentiM .


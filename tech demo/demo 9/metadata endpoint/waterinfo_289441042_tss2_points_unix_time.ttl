@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix tss: <https://w3id.org/tss#> .
@prefix ex: <https://example.org/ex#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix quantitykind: <http://qudt.org/vocab/quantitykind/> .
@prefix unit: <http://qudt.org/vocab/unit/> .

# Demo 7: experimental RDF time-series schema with field-level snippet locators.
# The new TSS schema, field, snippet and locator terms are proposal vocabulary.
# Logical datatypes interpret CSV and embedded-point lexical values; native types stay in the file.
# Snippet windows are [from, until).
# tss:key identifies the field whose values uniquely identify a row.
# tss:columnIndex is optional when tss:columnName identifies a field; indices are zero-based.
# RDFS/catalog annotations and external datatype/unit identifiers are retained.

# A copy of waterinfo_289441042_tss2_points_embedded.ttl (the same five readings) whose times are
# all Unix timestamps. The snippet states tss:timeDatatype xsd:integer, so every time in this
# document (in the snippet, the summaries and the points) is a Unix timestamp written as an
# integer, like "1614813300"^^xsd:integer.
# The snippet and its fields have their own IRIs (ex:zevenaarshaven-ut-...), so the documents never
# describe the same node in two ways; the sensor, the feature of interest and the station are the
# same real-world things, so they keep their IRIs.

# One embedded snippet contains both series, with one shared time field.
# The snippet window applies to all fields; the points are five-reading samples.
# The points are RDF at the end of this document (see "Points" below).

ex:zevenaarshaven-ut-snippet
    a tss:Snippet ;
    # The datatype of every time of this snippet: its tss:modifiedAt, tss:from, tss:until and
    # tss:committedUntil, the tss:from, tss:until, tss:firstTime, tss:lastTime and
    # tss:generatedAtTime of each summary, and the values of its tss:timeField (whose
    # tss:datatype is the same).
    # xsd:integer: every time is a Unix timestamp, the number of seconds since
    # 1970-01-01T00:00:00Z (UTC), leap seconds not counted, written as a whole number, 0 or more
    # ("1614813300" is 2021-03-03T23:15:00Z).
    tss:timeDatatype xsd:integer ;
    # Last edit of the snippet metadata; summary calculation times are separate.
    # 1793792603 = 2026-11-04T11:43:23Z
    tss:modifiedAt "1793792603"^^xsd:integer ;
    rdfs:label "Waterinfo EC20, Kanaal Gent-Terneuzen Zevenaarshaven (NL), Unix time"@en ;
    # Optional tss:snippetDescription; publishers may use any RDF vocabulary and properties.
    tss:snippetDescription [
        dcterms:spatial [
            a dcterms:Location ;
            rdfs:label "Kanaal Gent-Terneuzen Zevenaarshaven (NL)"@en
        ]
    ] ;
    tss:mutable false ;
    tss:producedBy ex:289441042 ;
    tss:embedded true ;
    tss:timeField ex:zevenaarshaven-ut-time-field ;
    tss:key ex:zevenaarshaven-ut-time-field ;
    # The window [2021-03-03T23:15:00Z, 2026-01-01T00:00:00Z).
    tss:from "1614813300"^^xsd:integer ;
    tss:until "1767225600"^^xsd:integer ;
    # Committed until: the last time the snippet and its data were checked to be up to date.
    # 1793015023 = 2026-10-26T11:43:43Z
    tss:committedUntil "1793015023"^^xsd:integer ;
    tss:hasField ex:zevenaarshaven-ut-time-field,
        ex:zevenaarshaven-ut-ec20-value-field,
        ex:zevenaarshaven-ut-quality-color-value-field .

# Generated column summaries (calculated from the actual data, not example values).
# Each summary covers existing rows/points in [tss:from, tss:until) only.
# tss:ExcludeEmptyValues excludes nulls, absent keys and empty strings ("");
# whitespace-only strings are not treated as empty. tss:count counts present values;
# tss:missing counts empty values in existing rows, not absent timestamps or time gaps.
# tss:firstTime / tss:lastTime are the first/last timestamps with a present field value.
# Numeric aggregates are for conductivity fields, in their declared units if known.
# Mean is the unweighted arithmetic mean; median averages the middle two values for even counts.
# All present readings are included regardless of quality codes or allowed bounds.
# Observed extrema do not replace the allowed tss:minimum / tss:maximum bounds.
# For embedded data these summaries describe only the supplied sample points.
# tss:generatedAtTime records calculation time; summaries are not refreshed automatically.
# The summary times are Unix timestamps (xsd:integer, the snippet's tss:timeDatatype):
# 1614813300 is 2021-03-03T23:15:00Z, 1614819600 is 2021-03-04T01:00:00Z,
# 1767225600 is 2026-01-01T00:00:00Z, 1792677750 is 2026-10-22T14:02:30Z.

ex:zevenaarshaven-ut-time-field
    a tss:Field ;
    tss:columnName "time" ;
    rdfs:label "Observation time"@en ;
    # The time field's datatype is the snippet's tss:timeDatatype.
    tss:datatype xsd:integer ;
    tss:fieldDescription [
        dcterms:description "Observation time"@en
    ] ;
    tss:summary [
        tss:from "1614813300"^^xsd:integer ;
        tss:until "1767225600"^^xsd:integer ;
        tss:missingValuePolicy tss:ExcludeEmptyValues ;
        tss:count "5"^^xsd:integer ;
        tss:missing "0"^^xsd:integer ;
        tss:firstTime "1614813300"^^xsd:integer ;
        tss:lastTime "1614819600"^^xsd:integer ;
        tss:generatedAtTime "1792677750"^^xsd:integer
    ] .

ex:zevenaarshaven-ut-ec20-value-field
    a tss:Field ;
    tss:columnName "ec20" ;
    rdfs:label "Electrical conductivity at 20 °C, Kanaal Gent-Terneuzen Zevenaarshaven (NL)"@en ;
    tss:datatype xsd:double ;
    tss:minimum "0"^^xsd:double ;
    # Example only: 10000 is a placeholder, not a real validated upper limit.
    tss:maximum "10000"^^xsd:double ;
    tss:observedProperty quantitykind:ElectricConductivity ;
    tss:unit unit:MicroS-PER-CentiM ;
    tss:sensor ex:sensor-zevenaarshaven-ec20 ;
    tss:featureOfInterest ex:water-zevenaarshaven ;
    tss:fieldDescription [
        dcterms:description "Electrical conductivity at 20 °C, Kanaal Gent-Terneuzen Zevenaarshaven (NL)"@en ;
        dcterms:subject quantitykind:ElectricConductivity ;
        dcterms:relation ex:sensor-zevenaarshaven-ec20, ex:water-zevenaarshaven
    ] ;
    tss:summary [
        tss:from "1614813300"^^xsd:integer ;
        tss:until "1767225600"^^xsd:integer ;
        tss:missingValuePolicy tss:ExcludeEmptyValues ;
        tss:count "5"^^xsd:integer ;
        tss:missing "0"^^xsd:integer ;
        tss:firstTime "1614813300"^^xsd:integer ;
        tss:lastTime "1614819600"^^xsd:integer ;
        tss:observedMinimum "4716.1"^^xsd:double ;
        tss:observedMaximum "4797.72"^^xsd:double ;
        tss:mean "4750.588"^^xsd:double ;
        tss:median "4745.36"^^xsd:double ;
        tss:generatedAtTime "1792677750"^^xsd:integer
    ] .

ex:zevenaarshaven-ut-quality-color-value-field
    a tss:Field ;
    tss:columnName "qualityColor" ;
    rdfs:label "Quality code colour of the EC20 values, Zevenaarshaven (NL)"@en ;
    tss:datatype xsd:string ;
    tss:observedProperty ex:qualityCodeColor ;
    tss:describesField ex:zevenaarshaven-ut-ec20-value-field ;
    tss:fieldDescription [
        dcterms:description "Quality code colour of the EC20 values, Zevenaarshaven (NL)"@en ;
        dcterms:subject ex:qualityCodeColor ;
        dcterms:relation ex:zevenaarshaven-ut-ec20-value-field
    ] ;
    tss:summary [
        tss:from "1614813300"^^xsd:integer ;
        tss:until "1767225600"^^xsd:integer ;
        tss:missingValuePolicy tss:ExcludeEmptyValues ;
        tss:count "5"^^xsd:integer ;
        tss:missing "0"^^xsd:integer ;
        tss:firstTime "1614813300"^^xsd:integer ;
        tss:lastTime "1614819600"^^xsd:integer ;
        tss:generatedAtTime "1792677750"^^xsd:integer
    ] .

# Points: one RDF node per point, at the end of the document, so that a new point of a
# mutable snippet is appended as one more Turtle statement without touching the rest.
# tss:pointOf links each point to its snippet. Each value has its field's IRI as predicate
# and is typed with the field's tss:datatype; a missing value has no triple.
# The points are unordered (sort by the value of the tss:timeField).
# Their times as Unix timestamps:
#   1614813300 = 2021-03-03T23:15:00Z    1614814200 = 2021-03-03T23:30:00Z
#   1614815100 = 2021-03-03T23:45:00Z    1614817800 = 2021-03-04T00:30:00Z
#   1614819600 = 2021-03-04T01:00:00Z

[] tss:pointOf ex:zevenaarshaven-ut-snippet ;
    ex:zevenaarshaven-ut-time-field "1614813300"^^xsd:integer ;
    ex:zevenaarshaven-ut-ec20-value-field "4797.72"^^xsd:double ;
    ex:zevenaarshaven-ut-quality-color-value-field "rgba(0, 128, 0, 1.0)"^^xsd:string .

[] tss:pointOf ex:zevenaarshaven-ut-snippet ;
    ex:zevenaarshaven-ut-time-field "1614814200"^^xsd:integer ;
    ex:zevenaarshaven-ut-ec20-value-field "4717.8"^^xsd:double ;
    ex:zevenaarshaven-ut-quality-color-value-field "rgba(0, 128, 0, 1.0)"^^xsd:string .

[] tss:pointOf ex:zevenaarshaven-ut-snippet ;
    ex:zevenaarshaven-ut-time-field "1614815100"^^xsd:integer ;
    ex:zevenaarshaven-ut-ec20-value-field "4745.36"^^xsd:double ;
    ex:zevenaarshaven-ut-quality-color-value-field "rgba(0, 128, 0, 1.0)"^^xsd:string .

[] tss:pointOf ex:zevenaarshaven-ut-snippet ;
    ex:zevenaarshaven-ut-time-field "1614817800"^^xsd:integer ;
    ex:zevenaarshaven-ut-ec20-value-field "4716.1"^^xsd:double ;
    ex:zevenaarshaven-ut-quality-color-value-field "rgba(0, 128, 0, 1.0)"^^xsd:string .

[] tss:pointOf ex:zevenaarshaven-ut-snippet ;
    ex:zevenaarshaven-ut-time-field "1614819600"^^xsd:integer ;
    ex:zevenaarshaven-ut-ec20-value-field "4775.96"^^xsd:double ;
    ex:zevenaarshaven-ut-quality-color-value-field "rgba(0, 128, 0, 1.0)"^^xsd:string .

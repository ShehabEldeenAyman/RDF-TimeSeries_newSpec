@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix tss: <https://w3id.org/tss#> .
@prefix ex: <https://example.org/ex#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix quantitykind: <http://qudt.org/vocab/quantitykind/> .
@prefix unit: <http://qudt.org/vocab/unit/> .

# Demo 7: experimental RDF time-series schema with field-level source locators.
# The new TSS schema, field, source and locator terms are proposal vocabulary.
# Logical datatypes interpret CSV and embedded-point lexical values; native types stay in the file.
# Source windows are [from, until).
# tss:key identifies the field whose values uniquely identify a row.
# RDFS/catalog annotations and external datatype/unit identifiers are retained.

# A copy of waterinfo_289441042_tss2_points_time_value.ttl (the same five readings) whose points
# state no full reading. The value field states a tss:baseline. Each point states the difference
# from it; the reading is tss:baseline + the point's value. The times are unchanged.
# New term (proposal vocabulary): tss:baseline.
# The source and its fields have their own IRIs (ex:zevenaarshaven-vd-...), so the documents never
# describe the same node in two ways; the sensor, the feature of interest and the station are the
# same real-world things, so they keep their IRIs.
# The points are RDF at the end of this document (see "Points" below).

ex:zevenaarshaven-vd-source
    a tss:Source ;
    # The datatype of every time of this source: its metadata times (tss:modifiedAt, the window,
    # tss:committedUntil and the summary times) and its tss:timeField's values (whose
    # tss:datatype is the same).
    # The points' times are xsd:dateTime literals with a timezone, such as 2021-03-03T23:15:00Z.
    tss:timeDatatype xsd:dateTime ;
    # Last edit of the source metadata; summary calculation times are separate.
    tss:modifiedAt "2026-11-04T08:56:19Z"^^xsd:dateTime ;
    rdfs:label "Waterinfo EC20, Kanaal Gent-Terneuzen Zevenaarshaven (NL), value delta points"@en ;
    # Optional tss:sourceDescription; publishers may use any RDF vocabulary and properties.
    tss:sourceDescription [
        dcterms:spatial [
            a dcterms:Location ;
            rdfs:label "Kanaal Gent-Terneuzen Zevenaarshaven (NL)"@en
        ]
    ] ;
    tss:mutable true ;
    tss:producedBy ex:289441042 ;
    tss:embedded true ;
    tss:timeField ex:zevenaarshaven-vd-time-field ;
    tss:key ex:zevenaarshaven-vd-time-field ;
    tss:from "2021-03-03T23:15:00Z"^^xsd:dateTime ;
    tss:until "2026-01-01T00:00:00Z"^^xsd:dateTime ;
    # Committed until: the last time the source and its data were checked to be up to date.
    tss:committedUntil "2026-10-26T11:43:43Z"^^xsd:dateTime ;
    tss:hasField ex:zevenaarshaven-vd-time-field,
        ex:zevenaarshaven-vd-value-field .

# Generated column summaries (calculated from the actual data, not example values).
# Each summary covers existing rows/points in [tss:from, tss:until) only.
# tss:ExcludeEmptyValues excludes nulls, absent keys and empty strings ("");
# whitespace-only strings are not treated as empty. tss:count counts present values;
# tss:missing counts empty values in existing rows, not absent timestamps or time gaps.
# tss:firstTime / tss:lastTime are the first/last timestamps with a present field value.
# Numeric aggregates are for the conductivity field, in its declared unit.
# Mean is the unweighted arithmetic mean; median averages the middle two values for even counts.
# Observed extrema do not replace the allowed tss:minimum / tss:maximum bounds.
# For embedded data these summaries describe only the supplied sample points.
# prov:generatedAtTime records calculation time; summaries are not refreshed automatically.
# The value summaries describe the readings (baseline + difference), not the differences
# the points state.

ex:zevenaarshaven-vd-time-field
    a tss:Field ;
    tss:columnName "time" ;
    rdfs:label "Observation time"@en ;
    tss:datatype xsd:dateTime ;
    tss:fieldDescription [
        dcterms:description "Observation time"@en
    ] ;
    tss:summary [
        tss:from "2021-03-03T23:15:00+00:00"^^xsd:dateTime ;
        tss:until "2026-01-01T00:00:00+00:00"^^xsd:dateTime ;
        tss:missingValuePolicy tss:ExcludeEmptyValues ;
        tss:count "5"^^xsd:integer ;
        tss:missing "0"^^xsd:integer ;
        tss:firstTime "2021-03-03T23:15:00+00:00"^^xsd:dateTime ;
        tss:lastTime "2021-03-04T01:00:00+00:00"^^xsd:dateTime ;
        prov:generatedAtTime "2026-10-26T09:03:01+00:00"^^xsd:dateTime
    ] .

ex:zevenaarshaven-vd-value-field
    a tss:Field ;
    tss:columnName "value" ;
    rdfs:label "Electrical conductivity at 20 °C, Kanaal Gent-Terneuzen Zevenaarshaven (NL)"@en ;
    tss:datatype xsd:double ;
    # The baseline of the readings, a literal of the field's tss:datatype. A point's value for this
    # field is the difference from it (typed with the field's tss:datatype too):
    # reading = tss:baseline + the point's value, summed exactly on the decimal values of the two
    # texts (4750 + 47.72 = 4797.72), then read as the field's tss:datatype.
    tss:baseline "4750"^^xsd:double ;
    # tss:minimum and tss:maximum bound the readings, not the differences.
    tss:minimum "0"^^xsd:double ;
    # Example only: 10000 is a placeholder, not a real validated upper limit.
    tss:maximum "10000"^^xsd:double ;
    tss:observedProperty quantitykind:ElectricConductivity ;
    tss:unit unit:MicroS-PER-CentiM ;
    tss:sensor ex:sensor-zevenaarshaven-ec20 ;
    tss:featureOfInterest ex:water-zevenaarshaven ;
    tss:fieldDescription [
        dcterms:description "Electrical conductivity at 20 °C, Kanaal Gent-Terneuzen Zevenaarshaven (NL)"@en ;
        dcterms:subject quantitykind:ElectricConductivity ;
        dcterms:relation ex:sensor-zevenaarshaven-ec20, ex:water-zevenaarshaven
    ] ;
    tss:summary [
        tss:from "2021-03-03T23:15:00+00:00"^^xsd:dateTime ;
        tss:until "2026-01-01T00:00:00+00:00"^^xsd:dateTime ;
        tss:missingValuePolicy tss:ExcludeEmptyValues ;
        tss:count "5"^^xsd:integer ;
        tss:missing "0"^^xsd:integer ;
        tss:firstTime "2021-03-03T23:15:00+00:00"^^xsd:dateTime ;
        tss:lastTime "2021-03-04T01:00:00+00:00"^^xsd:dateTime ;
        tss:observedMinimum "4716.1"^^xsd:double ;
        tss:observedMaximum "4797.72"^^xsd:double ;
        tss:mean "4750.588"^^xsd:double ;
        tss:median "4745.36"^^xsd:double ;
        prov:generatedAtTime "2026-10-26T09:03:01+00:00"^^xsd:dateTime
    ] .

# Points: one RDF node per point, at the end of the document, so that a new point of a
# mutable source is appended as one more Turtle statement without touching the rest.
# tss:pointOf links each point to its source. Each value has its field's IRI as predicate
# and is typed with the field's tss:datatype; a missing value has no triple.
# A point's value for ex:zevenaarshaven-vd-value-field is the difference from that field's
# tss:baseline (4750). The points are unordered (sort by the value of the tss:timeField).
# What they mean:
#   time                    reading (4750 + value)
#   2021-03-03T23:15:00Z    4750 + 47.72 = 4797.72
#   2021-03-03T23:30:00Z    4750 - 32.2  = 4717.8
#   2021-03-03T23:45:00Z    4750 - 4.64  = 4745.36
#   2021-03-04T00:30:00Z    4750 - 33.9  = 4716.1
#   2021-03-04T01:00:00Z    4750 + 25.96 = 4775.96

[] tss:pointOf ex:zevenaarshaven-vd-source ;
    ex:zevenaarshaven-vd-time-field "2021-03-03T23:15:00Z"^^xsd:dateTime ;
    ex:zevenaarshaven-vd-value-field "47.72"^^xsd:double .

[] tss:pointOf ex:zevenaarshaven-vd-source ;
    ex:zevenaarshaven-vd-time-field "2021-03-03T23:30:00Z"^^xsd:dateTime ;
    ex:zevenaarshaven-vd-value-field "-32.2"^^xsd:double .

[] tss:pointOf ex:zevenaarshaven-vd-source ;
    ex:zevenaarshaven-vd-time-field "2021-03-03T23:45:00Z"^^xsd:dateTime ;
    ex:zevenaarshaven-vd-value-field "-4.64"^^xsd:double .

[] tss:pointOf ex:zevenaarshaven-vd-source ;
    ex:zevenaarshaven-vd-time-field "2021-03-04T00:30:00Z"^^xsd:dateTime ;
    ex:zevenaarshaven-vd-value-field "-33.9"^^xsd:double .

[] tss:pointOf ex:zevenaarshaven-vd-source ;
    ex:zevenaarshaven-vd-time-field "2021-03-04T01:00:00Z"^^xsd:dateTime ;
    ex:zevenaarshaven-vd-value-field "25.96"^^xsd:double .

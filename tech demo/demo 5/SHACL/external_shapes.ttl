@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix tss:     <https://w3id.org/tss#> .
@prefix ext:     <https://w3id.org/tss/shapes/external-csv#> .

# =============================================================================
# RDFTSS conformance shapes, profile 1: readings in an EXTERNAL CSV file
#
# For a metadata endpoint whose tss:SnippetGroup has tss:embedded false: the group
# points to one CSV file (tss:dataFile) and its CSVW description (tss:describedby),
# and each snippet reads one column of that file (tss:valueColumn).
#
# Run:   pyshacl -w -s external_shapes.ttl "<endpoint>.ttl"
#        (-w: warnings alone don't fail the run; in Python: validate(..., allow_warnings=True))
# The endpoint conforms to this profile when the report holds no sh:Violation. (Plain SHACL
# sets sh:conforms to false as soon as the report holds any result, warnings included.)
#
# Numbers like "1.1.3" refer to the common requirements (the same in both profiles):
#   1.1    a snippet group exists, with
#   1.1.1    a label                       1.1.4  produced by
#   1.1.2    embedded                      1.1.5  a snippet template, with from (1.1.5.2),
#   1.1.3    mutable                              until, point type, time path, value path (1.1.5.3-6)
#   1.1.6    has snippet
#   1.2    a snippet exists
#   1.2.1    its label is optional
#   1.2.2    it has tss:about (contents not checked)
# Checks specific to this profile (all required):
#   E1 data file (tss:dataFile)            E4 time column (tss:timeColumn, own or from the template)
#   E2 CSVW description (tss:describedby)  E5 the value column is not the time column
#   E3 value column (tss:valueColumn)      E6 one snippet per column and period (warning)
#   E1 also requires the data file's type (dcterms:format, e.g. filetype:CSV or filetype:PARQUET)
#
# Every property shape is in one of these groups (sh:group):
#   Required     sh:Violation  missing or malformed: the endpoint does not conform
#   Recommended  sh:Warning    should be fixed, but the endpoint still conforms
#   Optional     -             may be left out; when present it must be well-formed (sh:Violation)
#   Not allowed  sh:Violation  contradicts this profile, or sh:Warning: has no effect in it
# =============================================================================

<https://w3id.org/tss/shapes/external-csv>
    a owl:Ontology ;
    rdfs:label "RDFTSS conformance shapes: readings in an external CSV file"@en ;
    sh:declare
        [ sh:prefix "tss" ; sh:namespace "https://w3id.org/tss#"^^xsd:anyURI ] ,
        [ sh:prefix "xsd" ; sh:namespace "http://www.w3.org/2001/XMLSchema#"^^xsd:anyURI ] .


# --- The labels ---------------------------------------------------------------

ext:Required a sh:PropertyGroup ;
    rdfs:label "Required"@en ;
    rdfs:comment "Must be present and well-formed (sh:Violation)."@en ;
    sh:order 0 .

ext:Recommended a sh:PropertyGroup ;
    rdfs:label "Recommended"@en ;
    rdfs:comment "Should be fixed; gives a sh:Warning, the endpoint still conforms."@en ;
    sh:order 1 .

ext:Optional a sh:PropertyGroup ;
    rdfs:label "Optional"@en ;
    rdfs:comment "May be left out; when present it must be well-formed (sh:Violation)."@en ;
    sh:order 2 .

ext:NotAllowed a sh:PropertyGroup ;
    rdfs:label "Not allowed"@en ;
    rdfs:comment "Contradicts this profile (sh:Violation) or has no effect in it (sh:Warning)."@en ;
    sh:order 3 .


# --- Reusable forms -----------------------------------------------------------

ext:PropertyPathShape a sh:NodeShape ;
    rdfs:label "A SHACL property path"@en ;
    rdfs:comment "A property IRI, a list (sequence path), or a node with sh:inversePath, sh:alternativePath, sh:zeroOrMorePath, sh:oneOrMorePath or sh:zeroOrOnePath. Used by tss:timePath and tss:valuePath."@en ;
    sh:or (
        [ sh:nodeKind sh:IRI ]
        [ sh:path rdf:first ; sh:minCount 1 ]
        [ sh:path sh:inversePath ; sh:minCount 1 ]
        [ sh:path sh:alternativePath ; sh:minCount 1 ]
        [ sh:path sh:zeroOrMorePath ; sh:minCount 1 ]
        [ sh:path sh:oneOrMorePath ; sh:minCount 1 ]
        [ sh:path sh:zeroOrOnePath ; sh:minCount 1 ]
    ) .

# A CSVW column name (csvw:name, CSVW 5.6): letters, digits, "_" and %-escapes, dot-separated
# parts, not starting with "_". A column title such as "Quality Code" is not a name.
# Used as sh:pattern "^([A-Za-z0-9]|%[0-9A-Fa-f]{2})([A-Za-z0-9_]|%[0-9A-Fa-f]{2})*([.]([A-Za-z0-9_]|%[0-9A-Fa-f]{2})+)*$"


# --- 1.1 and 1.2: a snippet group and a snippet exist ----------------------------
# sh:targetNode makes the class itself the focus node, whether or not it occurs in the
# data, so an endpoint without any group or snippet is reported instead of passing silently.

ext:GroupExistsShape a sh:NodeShape ;
    rdfs:label "1.1 A snippet group exists"@en ;
    sh:targetNode tss:SnippetGroup ;
    sh:property [
        sh:name "1.1 a snippet group" ;
        sh:path [ sh:inversePath rdf:type ] ;
        sh:minCount 1 ;
        sh:group ext:Required ;
        sh:message "1.1: the endpoint holds no tss:SnippetGroup."@en ] .

ext:SnippetExistsShape a sh:NodeShape ;
    rdfs:label "1.2 A snippet exists"@en ;
    sh:targetNode tss:Snippet ;
    sh:property [
        sh:name "1.2 a snippet" ;
        sh:path [ sh:inversePath rdf:type ] ;
        sh:minCount 1 ;
        sh:group ext:Required ;
        sh:message "1.2: the endpoint holds no tss:Snippet."@en ] .


# --- 1.1 The snippet group -----------------------------------------------------

ext:GroupShape a sh:NodeShape ;
    rdfs:label "1.1 Snippet group"@en ;
    sh:targetClass tss:SnippetGroup ;

    # 1.1.1 label
    sh:property [
        sh:name "1.1.1 label" ;
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
        sh:minLength 1 ;
        sh:group ext:Required ;
        sh:message "1.1.1: a snippet group needs a label (rdfs:label): a non-empty string, with or without a language tag."@en ] ,

    # 1.1.2 embedded: stated once, as a boolean ...
    [
        sh:name "1.1.2 embedded" ;
        sh:path tss:embedded ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:boolean ;
        sh:group ext:Required ;
        sh:message "1.1.2: state tss:embedded exactly once, as a boolean (false in this profile: the readings are in an external CSV file)."@en ] ,

    # ... and false in this profile (any form of the boolean false: false or "0")
    [
        sh:name "1.1.2 embedded is false" ;
        sh:path tss:embedded ;
        sh:not [ sh:in ( true "1"^^xsd:boolean ) ] ;
        sh:group ext:Required ;
        sh:message "1.1.2: tss:embedded is true: this group embeds its readings in its snippets, so check it with embedded_shapes.ttl."@en ] ,

    # 1.1.3 mutable
    [
        sh:name "1.1.3 mutable" ;
        sh:path tss:mutable ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:boolean ;
        sh:group ext:Required ;
        sh:message "1.1.3: state tss:mutable exactly once, as a boolean (true or false)."@en ] ,

    # 1.1.4 produced by
    [
        sh:name "1.1.4 produced by" ;
        sh:path tss:producedBy ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:group ext:Required ;
        sh:message "1.1.4: state tss:producedBy exactly once, as an IRI (the producing system or sensor)."@en ] ,

    # 1.1.5 snippet template (its contents: ext:TemplateShape)
    [
        sh:name "1.1.5 snippet template" ;
        sh:path tss:snippetTemplate ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class tss:SnippetTemplate ;
        sh:group ext:Required ;
        sh:message "1.1.5: a group has exactly one tss:snippetTemplate, a node typed tss:SnippetTemplate."@en ] ,

    # 1.1.6 has snippet
    [
        sh:name "1.1.6 has snippet" ;
        sh:path tss:hasSnippet ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class tss:Snippet ;
        sh:group ext:Required ;
        sh:message "1.1.6: a group lists at least one member with tss:hasSnippet; every member is an IRI typed tss:Snippet (a member that is not described in the endpoint fails this check)."@en ] ,

    # E1 data file
    [
        sh:name "E1 data file" ;
        sh:description "One group = one data file: the CSV file that holds the readings of every snippet in the group."@en ;
        sh:path tss:dataFile ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:group ext:Required ;
        sh:message "E1: state the group's CSV file exactly once, as an IRI, with tss:dataFile (one group = one data file)."@en ] ,

    # E1 data file format (only in this profile: embedded groups have no data file)
    [
        sh:name "E1 data file format" ;
        sh:description "The file type of tss:dataFile, as an IRI from the EU file-type vocabulary (http://publications.europa.eu/resource/authority/file-type/), e.g. CSV or PARQUET."@en ;
        sh:path dcterms:format ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:group ext:Required ;
        sh:message "E1: state the file type of tss:dataFile exactly once, as an IRI, with dcterms:format (e.g. filetype:CSV or filetype:PARQUET)."@en ] ,

    # E2 CSVW description
    [
        sh:name "E2 CSVW description" ;
        sh:description "The CSVW metadata of the data file. tss:timeColumn and tss:valueColumn are CSVW column names, so the CSVW file is needed to find them in the CSV."@en ;
        sh:path tss:describedby ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:group ext:Required ;
        sh:message "E2: state the CSVW metadata file of the data file exactly once, as an IRI, with tss:describedby."@en ] ,
    [
        sh:name "E2 CSVW description is not the data file" ;
        sh:path tss:describedby ;
        sh:disjoint tss:dataFile ;
        sh:group ext:Required ;
        sh:message "E2: tss:describedby points to the CSV file itself; it must point to the CSVW metadata that describes tss:dataFile."@en ] ,

    # Not allowed
    [
        sh:name "points" ;
        sh:path tss:points ;
        sh:maxCount 0 ;
        sh:group ext:NotAllowed ;
        sh:message "A group can't hold readings (tss:points); in this profile the readings are in the CSV file (tss:dataFile)."@en ] .


# --- 1.1.5 The snippet template ---------------------------------------------------

ext:TemplateShape a sh:NodeShape ;
    rdfs:label "1.1.5 Snippet template"@en ;
    sh:targetObjectsOf tss:snippetTemplate ;

    # E4 time column: usually stated here, as the default for every snippet. Whether each snippet
    # ends up with one (own or from here) is checked in ext:SnippetShape.
    sh:property [
        sh:name "E4 time column (default)" ;
        sh:path tss:timeColumn ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:pattern "^([A-Za-z0-9]|%[0-9A-Fa-f]{2})([A-Za-z0-9_]|%[0-9A-Fa-f]{2})*([.]([A-Za-z0-9_]|%[0-9A-Fa-f]{2})+)*$" ;
        sh:group ext:Required ;
        sh:message "E4: tss:timeColumn is one string that is a CSVW column name (its name, not its title)."@en ] ,

    # 1.1.5.2 from
    [
        sh:name "1.1.5.2 from" ;
        sh:path tss:from ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:dateTime ;
        sh:group ext:Required ;
        sh:message "1.1.5.2: the template states tss:from once, as an xsd:dateTime."@en ] ,

    # 1.1.5.3 until
    [
        sh:name "1.1.5.3 until" ;
        sh:path tss:until ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:dateTime ;
        sh:group ext:Required ;
        sh:message "1.1.5.3: the template states tss:until once, as an xsd:dateTime."@en ] ,

    # 1.1.5.2 and 1.1.5.3: with a timezone (the order of from and until: ext:TemplateTimeWindowShape)
    [
        sh:name "1.1.5.2-3 from and until have a timezone" ;
        sh:path [ sh:alternativePath ( tss:from tss:until ) ] ;
        sh:or ( [ sh:not [ sh:datatype xsd:dateTime ] ] [ sh:pattern "(Z|[+-][0-9]{2}:[0-9]{2})$" ] ) ;
        sh:severity sh:Warning ;
        sh:group ext:Recommended ;
        sh:message "1.1.5.2-3: this tss:from or tss:until has no timezone (Z or +hh:mm); it is compared as UTC."@en ] ,

    # 1.1.5.4 point type
    [
        sh:name "1.1.5.4 point type" ;
        sh:path tss:pointType ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:group ext:Required ;
        sh:message "1.1.5.4: the template states tss:pointType once, as a class IRI (for example sosa:Observation)."@en ] ,

    # 1.1.5.5 time path
    [
        sh:name "1.1.5.5 time path" ;
        sh:path tss:timePath ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node ext:PropertyPathShape ;
        sh:group ext:Required ;
        sh:message "1.1.5.5: the template states tss:timePath once, as a SHACL property path (a property IRI such as sosa:resultTime, or a path node)."@en ] ,

    # 1.1.5.6 value path
    [
        sh:name "1.1.5.6 value path" ;
        sh:path tss:valuePath ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node ext:PropertyPathShape ;
        sh:group ext:Required ;
        sh:message "1.1.5.6: the template states tss:valuePath once, as a SHACL property path (a property IRI such as sosa:hasSimpleResult, or a path node)."@en ] ,

    # Optional defaults beyond 1.1.5
    [
        sh:name "value column (default)" ;
        sh:path tss:valueColumn ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:pattern "^([A-Za-z0-9]|%[0-9A-Fa-f]{2})([A-Za-z0-9_]|%[0-9A-Fa-f]{2})*([.]([A-Za-z0-9_]|%[0-9A-Fa-f]{2})+)*$" ;
        sh:group ext:Optional ;
        sh:message "tss:valueColumn is one string that is a CSVW column name (its name, not its title)."@en ] ,
    [
        sh:name "about (default)" ;
        sh:path tss:about ;
        sh:maxCount 1 ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:group ext:Optional ;
        sh:message "tss:about is one point template (a node)."@en ] ,

    # Not allowed in this profile
    [
        sh:name "points" ;
        sh:path tss:points ;
        sh:maxCount 0 ;
        sh:group ext:NotAllowed ;
        sh:message "A template can't hold readings (tss:points), and this profile keeps the readings in the CSV file."@en ] ,
    [
        sh:name "context" ;
        sh:path tss:context ;
        sh:maxCount 0 ;
        sh:severity sh:Warning ;
        sh:group ext:NotAllowed ;
        sh:message "tss:context describes embedded JSON points; it has no effect when the readings are in a CSV file."@en ] ,
    [
        sh:name "group-level property on the template" ;
        sh:path [ sh:alternativePath ( tss:embedded tss:dataFile tss:describedby tss:mutable tss:producedBy tss:snippetTemplate tss:hasSnippet ) ] ;
        sh:maxCount 0 ;
        sh:severity sh:Warning ;
        sh:group ext:NotAllowed ;
        sh:message "tss:embedded, tss:dataFile, tss:describedby, tss:mutable, tss:producedBy, tss:snippetTemplate and tss:hasSnippet belong on the snippet group; on a template they have no effect."@en ] .

ext:TemplateTimeWindowShape a sh:NodeShape ;
    rdfs:label "1.1.5.2-3 The template's time window"@en ;
    sh:targetObjectsOf tss:snippetTemplate ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "1.1.5.2-3: the template's time window is empty: tss:from {?from} is not before tss:until {?until}."@en ;
        sh:prefixes <https://w3id.org/tss/shapes/external-csv> ;
        sh:select """
            SELECT $this ?from ?until WHERE {
                $this tss:from ?from ; tss:until ?until .
                FILTER (datatype(?from) = xsd:dateTime && datatype(?until) = xsd:dateTime)
                # a time without a timezone is compared as UTC
                BIND (IF(TZ(?from) = "", xsd:dateTime(CONCAT(STR(?from), "Z")), ?from) AS ?f)
                BIND (IF(TZ(?until) = "", xsd:dateTime(CONCAT(STR(?until), "Z")), ?until) AS ?u)
                FILTER (?f >= ?u)
            }
        """ ] .


# --- 1.2 The snippet --------------------------------------------------------------

ext:SnippetShape a sh:NodeShape ;
    rdfs:label "1.2 Snippet"@en ;
    sh:targetClass tss:Snippet ;

    # Membership: the template and data file a snippet uses come from its group
    sh:property [
        sh:name "1.1.6 member of one group" ;
        sh:path [ sh:inversePath tss:hasSnippet ] ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class tss:SnippetGroup ;
        sh:group ext:Required ;
        sh:message "Every snippet is a member (tss:hasSnippet) of exactly one tss:SnippetGroup: its data file and template come from there."@en ] ,

    # 1.2.1 label: optional
    [
        sh:name "1.2.1 label" ;
        sh:path rdfs:label ;
        sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
        sh:minLength 1 ;
        sh:group ext:Optional ;
        sh:message "1.2.1: a snippet's label (rdfs:label, optional) is a non-empty string, with or without a language tag."@en ] ,

    # 1.2.2 about: present; its contents are not checked
    [
        sh:name "1.2.2 about" ;
        sh:path tss:about ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:group ext:Required ;
        sh:message "1.2.2: a snippet states tss:about once: a point template node (its contents are not checked)."@en ] ,

    # E3 value column: on the snippet, or (unusually) as a default on the template
    [
        sh:name "E3 value column (own or inherited)" ;
        sh:path [ sh:alternativePath ( tss:valueColumn ( [ sh:inversePath tss:hasSnippet ] tss:snippetTemplate tss:valueColumn ) ) ] ;
        sh:minCount 1 ;
        sh:group ext:Required ;
        sh:message "E3: no value column: state tss:valueColumn on the snippet (the CSVW column that holds its readings)."@en ] ,
    [
        sh:name "E3 value column (form)" ;
        sh:path tss:valueColumn ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:pattern "^([A-Za-z0-9]|%[0-9A-Fa-f]{2})([A-Za-z0-9_]|%[0-9A-Fa-f]{2})*([.]([A-Za-z0-9_]|%[0-9A-Fa-f]{2})+)*$" ;
        sh:group ext:Required ;
        sh:message "E3: tss:valueColumn is one string that is a CSVW column name (its name, not its title)."@en ] ,

    # E4 time column: usually inherited from the template, or stated on the snippet itself
    [
        sh:name "E4 time column (own or inherited)" ;
        sh:path [ sh:alternativePath ( tss:timeColumn ( [ sh:inversePath tss:hasSnippet ] tss:snippetTemplate tss:timeColumn ) ) ] ;
        sh:minCount 1 ;
        sh:group ext:Required ;
        sh:message "E4: no time column: state tss:timeColumn on the group's template (or on the snippet itself)."@en ] ,
    [
        sh:name "E4 time column (form)" ;
        sh:path tss:timeColumn ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:pattern "^([A-Za-z0-9]|%[0-9A-Fa-f]{2})([A-Za-z0-9_]|%[0-9A-Fa-f]{2})*([.]([A-Za-z0-9_]|%[0-9A-Fa-f]{2})+)*$" ;
        sh:group ext:Required ;
        sh:message "E4: tss:timeColumn is one string that is a CSVW column name (its name, not its title)."@en ] ,

    # Optional: a snippet may override its template's values (the TSS2 inheritance rule)
    [
        sh:name "from (override)" ; sh:path tss:from ;
        sh:maxCount 1 ; sh:datatype xsd:dateTime ; sh:group ext:Optional ;
        sh:message "A snippet's own tss:from is one xsd:dateTime."@en ] ,
    [
        sh:name "until (override)" ; sh:path tss:until ;
        sh:maxCount 1 ; sh:datatype xsd:dateTime ; sh:group ext:Optional ;
        sh:message "A snippet's own tss:until is one xsd:dateTime."@en ] ,
    [
        sh:name "from and until have a timezone (override)" ;
        sh:path [ sh:alternativePath ( tss:from tss:until ) ] ;
        sh:or ( [ sh:not [ sh:datatype xsd:dateTime ] ] [ sh:pattern "(Z|[+-][0-9]{2}:[0-9]{2})$" ] ) ;
        sh:severity sh:Warning ; sh:group ext:Recommended ;
        sh:message "This tss:from or tss:until has no timezone (Z or +hh:mm); it is compared as UTC."@en ] ,
    [
        sh:name "point type (override)" ; sh:path tss:pointType ;
        sh:maxCount 1 ; sh:nodeKind sh:IRI ; sh:group ext:Optional ;
        sh:message "A snippet's own tss:pointType is one class IRI."@en ] ,
    [
        sh:name "time path (override)" ; sh:path tss:timePath ;
        sh:maxCount 1 ; sh:node ext:PropertyPathShape ; sh:group ext:Optional ;
        sh:message "A snippet's own tss:timePath is one SHACL property path."@en ] ,
    [
        sh:name "value path (override)" ; sh:path tss:valuePath ;
        sh:maxCount 1 ; sh:node ext:PropertyPathShape ; sh:group ext:Optional ;
        sh:message "A snippet's own tss:valuePath is one SHACL property path."@en ] ,

    # Optional extra description
    [
        sh:name "identifier" ; sh:path dcterms:identifier ;
        sh:nodeKind sh:Literal ; sh:group ext:Optional ;
        sh:message "dcterms:identifier is a literal."@en ] ,
    [
        sh:name "comment" ; sh:path rdfs:comment ;
        sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ; sh:group ext:Optional ;
        sh:message "rdfs:comment is a string, with or without a language tag."@en ] ,

    # Not allowed in this profile
    [
        sh:name "points" ; sh:path tss:points ;
        sh:maxCount 0 ; sh:group ext:NotAllowed ;
        sh:message "tss:points embeds readings in the snippet; in this profile (tss:embedded false) the readings are in the CSV file (tss:dataFile)."@en ] ,
    [
        sh:name "context" ; sh:path tss:context ;
        sh:maxCount 0 ; sh:severity sh:Warning ; sh:group ext:NotAllowed ;
        sh:message "tss:context describes embedded JSON points; it has no effect when the readings are in a CSV file."@en ] ,
    [
        sh:name "group-level property on the snippet" ;
        sh:path [ sh:alternativePath ( tss:embedded tss:dataFile tss:describedby tss:mutable tss:producedBy tss:snippetTemplate tss:hasSnippet ) ] ;
        sh:maxCount 0 ; sh:severity sh:Warning ; sh:group ext:NotAllowed ;
        sh:message "tss:embedded, tss:dataFile, tss:describedby, tss:mutable, tss:producedBy, tss:snippetTemplate and tss:hasSnippet belong on the snippet group; on a snippet they have no effect."@en ] .


# --- Checks across the snippet and its template (SHACL-SPARQL) --------------------
# "Own or inherited": a snippet uses its own value, else its group template's (the TSS2 rule).

ext:TimeWindowShape a sh:NodeShape ;
    rdfs:label "Time window after overrides"@en ;
    sh:targetClass tss:Snippet ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The snippet's time window is empty: tss:from {?from} is not before tss:until {?until} (its own value, else the template's)."@en ;
        sh:prefixes <https://w3id.org/tss/shapes/external-csv> ;
        # Only when the snippet overrides from or until: the template alone is checked by ext:TemplateTimeWindowShape.
        sh:select """
            SELECT $this ?from ?until WHERE {
                OPTIONAL { $this tss:from ?ownFrom }
                OPTIONAL { $this tss:until ?ownUntil }
                OPTIONAL {
                    ?group tss:hasSnippet $this ; tss:snippetTemplate ?template .
                    OPTIONAL { ?template tss:from ?templateFrom }
                    OPTIONAL { ?template tss:until ?templateUntil }
                }
                FILTER (BOUND(?ownFrom) || BOUND(?ownUntil))
                BIND (COALESCE(?ownFrom, ?templateFrom) AS ?from)
                BIND (COALESCE(?ownUntil, ?templateUntil) AS ?until)
                FILTER (datatype(?from) = xsd:dateTime && datatype(?until) = xsd:dateTime)
                # a time without a timezone is compared as UTC
                BIND (IF(TZ(?from) = "", xsd:dateTime(CONCAT(STR(?from), "Z")), ?from) AS ?f)
                BIND (IF(TZ(?until) = "", xsd:dateTime(CONCAT(STR(?until), "Z")), ?until) AS ?u)
                FILTER (?f >= ?u)
            }
        """ ] .

ext:DistinctColumnsShape a sh:NodeShape ;
    rdfs:label "E5 Value column differs from time column"@en ;
    sh:targetClass tss:Snippet ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "E5: the snippet reads its values from its time column ({?column})."@en ;
        sh:prefixes <https://w3id.org/tss/shapes/external-csv> ;
        sh:select """
            SELECT $this ?column WHERE {
                OPTIONAL { $this tss:valueColumn ?ownValue }
                OPTIONAL { $this tss:timeColumn ?ownTime }
                OPTIONAL {
                    ?group tss:hasSnippet $this ; tss:snippetTemplate ?template .
                    OPTIONAL { ?template tss:valueColumn ?templateValue }
                    OPTIONAL { ?template tss:timeColumn ?templateTime }
                }
                BIND (COALESCE(?ownValue, ?templateValue) AS ?column)
                BIND (COALESCE(?ownTime, ?templateTime) AS ?timeColumn)
                FILTER (BOUND(?column) && BOUND(?timeColumn) && STR(?column) = STR(?timeColumn))
            }
        """ ] .

ext:OneSnippetPerColumnShape a sh:NodeShape ;
    rdfs:label "E6 One snippet per value column and period"@en ;
    rdfs:comment "Two snippets may read the same column over periods that don't overlap (tss:until is exclusive)."@en ;
    sh:targetClass tss:Snippet ;
    sh:severity sh:Warning ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "E6: another snippet of the same group ({?other}) also reads value column {?column} over an overlapping time window: one snippet per series and period."@en ;
        sh:prefixes <https://w3id.org/tss/shapes/external-csv> ;
        sh:select """
            SELECT $this ?other ?column WHERE {
                ?group tss:hasSnippet $this , ?other .
                FILTER ($this != ?other)
                OPTIONAL {
                    ?group tss:snippetTemplate ?template .
                    OPTIONAL { ?template tss:valueColumn ?templateColumn }
                    OPTIONAL { ?template tss:from ?templateFrom }
                    OPTIONAL { ?template tss:until ?templateUntil }
                }
                OPTIONAL { $this tss:valueColumn ?ownColumn }
                OPTIONAL { ?other tss:valueColumn ?otherOwnColumn }
                BIND (COALESCE(?ownColumn, ?templateColumn) AS ?column)
                BIND (COALESCE(?otherOwnColumn, ?templateColumn) AS ?otherColumn)
                FILTER (BOUND(?column) && BOUND(?otherColumn) && STR(?column) = STR(?otherColumn))
                OPTIONAL { $this tss:from ?ownFrom }
                OPTIONAL { $this tss:until ?ownUntil }
                OPTIONAL { ?other tss:from ?otherOwnFrom }
                OPTIONAL { ?other tss:until ?otherOwnUntil }
                BIND (COALESCE(?ownFrom, ?templateFrom) AS ?from)
                BIND (COALESCE(?ownUntil, ?templateUntil) AS ?until)
                BIND (COALESCE(?otherOwnFrom, ?templateFrom) AS ?otherFrom)
                BIND (COALESCE(?otherOwnUntil, ?templateUntil) AS ?otherUntil)
                # the windows overlap; a missing bound counts as open
                FILTER (!BOUND(?from) || !BOUND(?otherUntil) || ?from < ?otherUntil)
                FILTER (!BOUND(?otherFrom) || !BOUND(?until) || ?otherFrom < ?until)
            }
        """ ] .

ext:KnownTermsShape a sh:NodeShape ;
    rdfs:label "No unknown tss: properties"@en ;
    rdfs:comment "Catches typos such as tss:mutabel, which would otherwise be ignored silently."@en ;
    sh:targetClass tss:SnippetGroup , tss:Snippet ;
    sh:targetObjectsOf tss:snippetTemplate ;
    sh:severity sh:Warning ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Unknown TSS property {?property} (a typo?): it is ignored."@en ;
        sh:prefixes <https://w3id.org/tss/shapes/external-csv> ;
        sh:select """
            SELECT DISTINCT $this ?property WHERE {
                $this ?property ?value .
                FILTER (STRSTARTS(STR(?property), "https://w3id.org/tss#"))
                FILTER (?property NOT IN (tss:embedded, tss:dataFile, tss:describedby, tss:mutable,
                    tss:producedBy, tss:snippetTemplate, tss:hasSnippet, tss:timeColumn, tss:valueColumn,
                    tss:from, tss:until, tss:pointType, tss:timePath, tss:valuePath, tss:about,
                    tss:points, tss:context))
            }
        """ ] .

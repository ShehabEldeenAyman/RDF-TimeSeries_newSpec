# The three RO1D/E feed series have no qudt:hasUnit: the source labels them m3/h,
# which is not a conductivity unit, so their unit is still to be confirmed.

ex:snippet-ro1de_feed_conductivity-2025 a tss:Snippet ;
    rdfs:label "RO1D+E combined feed conductivity, 2025"@en ;
    tss:valueColumn "ro1de_feed_conductivity" ;
    tss:about [
        sosa:madeBySensor ex:sensor-ro1de_feed ;
        sosa:observedProperty quantitykind:ElectricConductivity ;
        sosa:hasFeatureOfInterest ex:ro1de_feed ] ;
    rdfs:comment "Unit not confirmed: the source system labels this sensor m3/h, which is not a conductivity unit."@en .

ex:snippet-ro1d_feed_conductivity-2025 a tss:Snippet ;
    rdfs:label "RO1D feed conductivity (after chemical injection), 2025"@en ;

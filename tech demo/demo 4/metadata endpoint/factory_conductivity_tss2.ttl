@prefix quantitykind: <http://qudt.org/vocab/quantitykind/> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix tss: <https://w3id.org/tss#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ex: <https://example.org/ex#> .
@prefix ldes: <https://w3id.org/ldes#> .
@prefix csvw: <http://www.w3.org/ns/csvw#> .
@prefix wdrs: <http://www.w3.org/2007/05/powder-s#> .
@prefix td: <https://www.w3.org/2019/wot/td#> .
@prefix hctl: <https://www.w3.org/2019/wot/hypermedia#> .

ex:factory-table a csvw:Table ;
    csvw:url <../data/factory_conductivity.csv> ;
    wdrs:describedby <../csvw/factory_conductivity_csvw.json> ; # same relation CSVW uses for rel="describedby" discovery
    tss:mutable false ;
    tss:committedUntil "2025-12-31T23:45:00Z"^^xsd:dateTime ;
    tss:producedBy ex:system1 ;
    tss:startingFrom "2025-01-01T00:00:00Z"^^xsd:dateTime .

ex:factory-snippet a tss:SnippetGroup ;
    rdfs:label "Factory water conductivity, 2025"@en ;
    tss:snippetTemplate [
         a tss:SnippetTemplate ; #defaults each member snippet inherits.
        tss:table ex:factory-table ;
        tss:timeColumn "datetime" ;
        tss:from "2025-01-01T00:00:00Z"^^xsd:dateTime ;
        tss:until "2026-01-01T00:00:00Z"^^xsd:dateTime ;
        tss:pointType sosa:Observation ;
        tss:timePath sosa:resultTime ;
        tss:valuePath sosa:hasSimpleResult ] ;

    tss:hasSnippet
        ex:snippet-ro1_a_permeate_conductivity-2025 ,
        ex:snippet-ro1_b_permeate_conductivity-2025 ,
        ex:snippet-ro1_c_permeate_conductivity-2025 ,
        ex:snippet-ro2_a_permeate_conductivity-2025 ,
        ex:snippet-ro2_b_permeate_conductivity-2025 ,
        ex:snippet-cooling_water_conductivity-2025 ,
        ex:snippet-boiler_feed_conductivity-2025 ,
        ex:snippet-boiler_water_delivery_conductivity-2025 ,
        ex:snippet-dockwater_blowdown_conductivity-2025 ,
        ex:snippet-venturi_reject_conductivity-2025 ,
        ex:snippet-ro1de_feed_conductivity-2025 ,
        ex:snippet-ro1d_feed_conductivity-2025 ,
        ex:snippet-ro1e_feed_conductivity-2025 .

# One snippet per time series, i.e. per value column of the table. 

ex:snippet-ro1_a_permeate_conductivity-2025 a tss:Snippet ;
    rdfs:label "RO1 train A permeate conductivity, 2025"@en ;
    tss:valueColumn "ro1_a_permeate_conductivity" ;
    tss:about [
        sosa:madeBySensor ex:sensor-ro1_a_permeate ;
        sosa:observedProperty quantitykind:ElectricConductivity ;
        sosa:hasFeatureOfInterest ex:ro1_a_permeate ;
        qudt:hasUnit unit:MicroS-PER-CentiM ] .


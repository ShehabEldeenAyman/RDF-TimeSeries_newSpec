@prefix quantitykind: <http://qudt.org/vocab/quantitykind/> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix tss: <https://w3id.org/tss#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ex: <https://example.org/ex#> .
@prefix ldes: <https://w3id.org/ldes#> .
@prefix csvw: <http://www.w3.org/ns/csvw#> .
@prefix wdrs: <http://www.w3.org/2007/05/powder-s#> .
@prefix td: <https://www.w3.org/2019/wot/td#> .
@prefix hctl: <https://www.w3.org/2019/wot/hypermedia#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# One group = one data file: every snippet in this group reads its values from tss:dataFile.
ex:grootdok-snippets a tss:SnippetGroup ;
    rdfs:label "Waterinfo EC20, Kanaal Gent-Terneuzen Grootdok (BE)"@en ;
    tss:dataFile <../data/waterinfo_289423042.csv> ;
    wdrs:describedby <../csvw/waterinfo_289423042_csvw.json> ; # same relation as CSVW's rel="describedby" link
    tss:mutable false ;
    tss:producedBy ex:station-grootdok ;
    tss:snippetTemplate [
        a tss:SnippetTemplate ; #defaults each member snippet inherits.
        tss:timeColumn "timestamp" ;
        tss:from "2021-03-03T23:45:00Z"^^xsd:dateTime ;
        tss:until "2025-12-18T23:15:00Z"^^xsd:dateTime ;
        tss:pointType sosa:Observation ;
        tss:timePath sosa:resultTime ;
        tss:valuePath sosa:hasSimpleResult ] ;

    tss:hasSnippet ex:snippet-grootdok-ec20 .

# One snippet per time series; this file holds a single series (waterinfo ts_id 289423042).
# The interpolation and quality columns vary per row, so they are described in the
# CSVW metadata but not bound here.

ex:snippet-grootdok-ec20 a tss:Snippet ;
    rdfs:label "Electrical conductivity at 20 °C, Kanaal Gent-Terneuzen Grootdok (BE)"@en ;
    dcterms:identifier "289423042" ;
    tss:valueColumn "value" ;
    tss:embedded false; # Indicates whether actual time series data reside in the snippet or not.
    tss:about [
        sosa:madeBySensor ex:sensor-grootdok-ec20 ;
        sosa:observedProperty quantitykind:ElectricConductivity ;
        sosa:hasFeatureOfInterest ex:water-grootdok ;
        qudt:hasUnit unit:MicroS-PER-CentiM ] .
